# =============================================================================
# UAL Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Hetzner Cloud API
# https://console.hetzner.cloud/ → Security → API Tokens
# -----------------------------------------------------------------------------
HETZNER_API_TOKEN=

# -----------------------------------------------------------------------------
# Porkbun DNS API
# https://porkbun.com/account/api
# -----------------------------------------------------------------------------
PORKBUN_API_KEY=
PORKBUN_API_SECRET=

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# Base domain for your deployment (e.g., example.com)
UAL_BASE_DOMAIN=

# Server name in Hetzner (default: ual-server)
UAL_SERVER_NAME=ual-server

# -----------------------------------------------------------------------------
# GitHub Access (for private repos)
# https://github.com/settings/tokens - needs 'repo' scope
# -----------------------------------------------------------------------------
# Only required if your UAL repo is private
GITHUB_TOKEN=

# Custom repo URL (optional, defaults to cognivore/universal-art-link)
# UAL_REPO_URL=https://github.com/your-org/your-ual-fork.git

# -----------------------------------------------------------------------------
# Stripe Test/Staging Keys
# https://dashboard.stripe.com/test/apikeys
# Use these for development and staging environments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# -----------------------------------------------------------------------------
# Stripe Live/Production Keys
# https://dashboard.stripe.com/apikeys
# Use these for production only - real money!
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Authentication Secrets
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
# JWT signing secret (for session tokens)
UAL_JWT_SECRET=

# Magic link signing secret (for email verification tokens)
UAL_MAGIC_LINK_SECRET=

# -----------------------------------------------------------------------------
# Staging-Only Settings
# NEVER use these in production!
# -----------------------------------------------------------------------------
# Enable staging auth bypass (allows is_santa JWT)
UAL_STAGING_BYPASS=false

# Pre-generated staging JWT with is_santa=true claim
# Generate with: pnpm staging:jwt
UAL_STAGING_JWT=

# -----------------------------------------------------------------------------
# Email Service (Optional - for production magic links)
# Using Resend as an example: https://resend.com/
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Admin Configuration
# -----------------------------------------------------------------------------
# Base URL for the admin panel (used in magic link emails)
# UAL_ADMIN_BASE_URL=https://example.com/admin

# -----------------------------------------------------------------------------
# Authorized Admin Users
# -----------------------------------------------------------------------------
# Admin users are configured in: content/auth/admins.yaml
#
# Example format:
#   admins:
#     - email: "emilie.mchl@gmail.com"
#       name: "Pupina"
#     - email: "jm@memorici.de"
#       name: "Kartupelis"
#
# Only emails listed in admins.yaml can receive magic links and log in.
# Edit this file to add/remove admin access.

