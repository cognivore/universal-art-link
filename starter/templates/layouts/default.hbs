<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{meta.title}}</title>
    <meta name="description" content="{{meta.description}}" />
    <link rel="canonical" href="{{meta.canonicalUrl}}" />
    {{#if site.favicon}}
    <link rel="icon" type="image/svg+xml" href="{{site.favicon}}" />
    {{/if}}
    <link rel="stylesheet" href="{{assets.styles}}" />
    <script defer src="{{assets.scripts}}"></script>
    <style>
      :root {
        {{themeVars}}
      }
    </style>
  </head>
  <body class="ual-body" data-density="{{site.theme.density}}" data-mode="{{site.theme.mode}}">
    <div class="page-shell">
      <header class="site-header">
        <a class="logo" href="{{assets.base}}/">{{site.siteTitle}}</a>
        <nav class="site-nav">
          {{#each navigation}}
          <a href="{{href}}" class="nav-link {{#if active}}is-active{{/if}}">{{label}}</a>
          {{/each}}
        </nav>
        <button class="nav-toggle" data-nav-toggle>Menu</button>
      </header>
      <main class="site-main">
        {{#each sections}}
          {{{this}}}
        {{/each}}
      </main>
      <footer class="site-footer">
        <div class="footer-meta">
          <p class="micro-label">{{site.siteDescription}}</p>
          <span class="muted">© {{site.siteTitle}}</span>
        </div>
        <div class="footer-links">
          {{#each socialLinks}}
          <a href="{{href}}" target="_blank" rel="noreferrer">{{label}}</a>
          {{/each}}
        </div>
      </footer>
    </div>
  </body>
</html>

