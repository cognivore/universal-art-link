<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{meta.title}}</title>
    <meta name="description" content="{{meta.description}}" />
    <link rel="canonical" href="{{meta.canonicalUrl}}" />
    <link rel="stylesheet" href="{{assets.styles}}" />
    <script defer src="{{assets.scripts}}"></script>
    <style>
      :root {
        {{themeVars}}
      }
    </style>
  </head>
  <body class="ual-body layout-index" data-density="{{site.theme.density}}">
    <div class="page-shell">
      <header class="site-header site-header--stacked">
        <div>
          <a class="logo" href="{{assets.base}}/">{{site.siteTitle}}</a>
          <p class="micro-label muted">{{site.siteDescription}}</p>
        </div>
        <nav class="site-nav site-nav--stacked">
          {{#each navigation}}
          <a href="{{href}}" class="nav-link {{#if active}}is-active{{/if}}">{{label}}</a>
          {{/each}}
        </nav>
      </header>
      <main class="site-main">
        {{#each sections}}
          {{{this}}}
        {{/each}}
      </main>
      <footer class="site-footer">
        <div class="footer-links">
          {{#each socialLinks}}
          <a href="{{href}}" target="_blank" rel="noreferrer">{{label}}</a>
          {{/each}}
        </div>
      </footer>
    </div>
  </body>
</html>

