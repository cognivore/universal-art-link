{{!--
  WARNING: DO NOT AUTO-FORMAT THIS FILE

  Handlebars syntax MUST remain intact: {{variable}}
  Auto-formatters often break {{ }} delimiters by adding spaces/newlines.
  This file is protected by .prettierignore and validated by tests.

  Critical variables that must not be malformed:
  - {{themeVars}} must be exactly {{themeVars}}, NOT { { themeVars } }
--}}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{meta.title}}</title>
    <meta name="description" content="{{meta.description}}" />
    <link rel="canonical" href="{{meta.canonicalUrl}}" />
    <link rel="stylesheet" href="{{assets.styles}}" />
    <script defer src="{{assets.scripts}}"></script>
    <style>
      :root {
        {{themeVars}}
      }
    </style>
  </head>
  <body class="ual-body layout-project">
    <div class="project-shell">
      {{> site-header}}
      <div class="project-layout">
        <aside class="project-nav">
          <p class="micro-label muted">{{site.siteDescription}}</p>
          <div class="project-meta">
            {{#each socialLinks}}
            <a href="{{href}}" target="_blank" rel="noreferrer">{{label}}</a>
            {{/each}}
          </div>
        </aside>
        <main class="site-main project-main">
          {{#each sections}}
            {{{this}}}
          {{/each}}
        </main>
      </div>
    </div>
  </body>
</html>

