#!/usr/bin/env ysh
# =============================================================================
# UAL Server Provisioning
# Creates Hetzner server and bootstraps with required software
# =============================================================================

source-guard provision.ysh || return 0

source $_this_dir/lib/config.ysh
source $_this_dir/lib/hetzner.ysh

# -----------------------------------------------------------------------------
# Bootstrap Script
# -----------------------------------------------------------------------------

proc get_bootstrap_script {
  # Returns the bootstrap script to run on fresh server
  cat << 'BOOTSTRAP'
#!/bin/bash
set -euo pipefail

echo "=== UAL Server Bootstrap ==="
echo "Started at: $(date)"

# Update system
apt-get update -y
apt-get upgrade -y

# Install essential packages
apt-get install -y \
  curl \
  git \
  jq \
  unzip \
  build-essential \
  ca-certificates \
  gnupg

# Install Node.js 20.x LTS
if ! command -v node &> /dev/null; then
  echo "Installing Node.js..."
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
fi

# Install pnpm
if ! command -v pnpm &> /dev/null; then
  echo "Installing pnpm..."
  npm install -g pnpm
fi

# Install Caddy
if ! command -v caddy &> /dev/null; then
  echo "Installing Caddy..."
  apt-get install -y debian-keyring debian-archive-keyring apt-transport-https
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list
  apt-get update
  apt-get install -y caddy
fi

# Create UAL directories
mkdir -p /opt/ual/staging
mkdir -p /opt/ual/production
mkdir -p /var/log/ual

# Create UAL user
if ! id -u ual &>/dev/null; then
  useradd -r -s /bin/false ual
fi

chown -R ual:ual /opt/ual
chown -R ual:ual /var/log/ual

echo "=== Bootstrap Complete ==="
echo "Finished at: $(date)"
BOOTSTRAP
}

# -----------------------------------------------------------------------------
# Main Provision Function
# -----------------------------------------------------------------------------

proc provision {
  require_commands curl jq ssh scp

  log_section "Provisioning UAL Server"

  # Create server
  create_server

  if test -z "$SERVER_IP" {
    log_error "Failed to get server IP"
    return 1
  }

  # Wait for SSH
  wait_for_ssh "$SERVER_IP"

  # Run bootstrap
  log_section "Running Bootstrap Script"

  var bootstrap_script = $(get_bootstrap_script)
  echo "$bootstrap_script" | ssh_exec "$SERVER_IP" "cat > /tmp/bootstrap.sh && chmod +x /tmp/bootstrap.sh && /tmp/bootstrap.sh"

  log_section "Provisioning Complete"
  log "Server IP: $SERVER_IP"
  log "Staging domain: $STAGING_DOMAIN"
  log "Production domain: $PROD_DOMAIN"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

if is-main {
  init_config
  provision
}
