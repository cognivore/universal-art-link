#!/usr/bin/env ysh
# =============================================================================
# Caddy TLS Configuration
# Configures Caddy as reverse proxy with automatic TLS
# =============================================================================

source-guard caddy.ysh || return 0

source $_this_dir/lib/config.ysh
source $_this_dir/lib/hetzner.ysh

# -----------------------------------------------------------------------------
# Caddyfile Generation
# -----------------------------------------------------------------------------

proc generate_caddyfile {
  var staging_domain = STAGING_DOMAIN
  var prod_domain = PROD_DOMAIN
  var staging_port = CONFIG.staging_port
  var prod_port = CONFIG.prod_port

  cat << CADDYFILE
# UAL Reverse Proxy Configuration
# Auto-generated by deploy/caddy.ysh

# Staging instance (test Stripe keys, auth bypass enabled)
$staging_domain {
    reverse_proxy 127.0.0.1:$staging_port

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/staging-access.log
        format json
    }
}

# Production instance (live Stripe keys, full auth)
$prod_domain {
    reverse_proxy 127.0.0.1:$prod_port

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output file /var/log/caddy/production-access.log
        format json
    }
}
CADDYFILE
}

# -----------------------------------------------------------------------------
# Configure Caddy on Remote
# -----------------------------------------------------------------------------

proc configure_caddy {
  log_section "Configuring Caddy"

  if test -z "$SERVER_IP" {
    setglobal SERVER_IP = $(get_server_ip "$[CONFIG.server_name]")
  }

  if test -z "$SERVER_IP" {
    log_error "Server IP not found. Run provision first."
    return 1
  }

  log "Server IP: $SERVER_IP"
  log "Staging: $STAGING_DOMAIN -> :$[CONFIG.staging_port]"
  log "Production: $PROD_DOMAIN -> :$[CONFIG.prod_port]"

  # Generate Caddyfile
  var caddyfile = $(generate_caddyfile)

  # Upload and configure - encode to base64 for safe transmission
  log "Uploading Caddyfile..."

  var caddyfile_b64 = $(echo "$caddyfile" | base64)

  ssh_exec "$SERVER_IP" "
    set -e

    # Decode and write Caddyfile
    echo '$caddyfile_b64' | base64 -d > /etc/caddy/Caddyfile

    # Create log directories with correct ownership and permissions
    # This is CRITICAL - Caddy runs as 'caddy' user and needs write access
    mkdir -p /var/log/caddy
    chown -R caddy:caddy /var/log/caddy
    chmod 755 /var/log/caddy

    # Validate Caddyfile
    echo 'Validating Caddyfile...'
    caddy validate --config /etc/caddy/Caddyfile

    # Reload Caddy (restart if reload fails)
    echo 'Reloading Caddy...'
    systemctl reload caddy || systemctl restart caddy

    # Wait for TLS certificates (ACME can take a moment)
    echo 'Waiting for Caddy to obtain TLS certificates...'
    sleep 5

    # Check status
    if systemctl is-active --quiet caddy; then
      echo 'Caddy is running'
      # Show certificate status
      echo ''
      echo '=== TLS Certificate Status ==='
      caddy list-modules 2>/dev/null | head -5 || true
    else
      echo 'ERROR: Caddy failed to start'
      journalctl -u caddy --no-pager -n 30
      exit 1
    fi
  "

  log_success "Caddy configured!"
  log ""
  log "Staging:    https://$STAGING_DOMAIN"
  log "Production: https://$PROD_DOMAIN"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

if is-main {
  require_commands ssh

  init_config
  configure_caddy
}
