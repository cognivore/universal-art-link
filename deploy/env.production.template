# ─── UAL v2 Production Environment ───────────────────────────────────
# Copy to /opt/ual-v2/.env and fill in real values

# ─── Postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ual_v2:CHANGE_ME@localhost:5432/ual_v2

# ─── Platform mode ───────────────────────────────────────────────────
# "self_host" for single-tenant, "hosted" for multi-tenant SaaS
UAL_MODE=self_host

# The domain this instance serves (used for tenant resolution)
UAL_BASE_DOMAIN=new.okashi-school.com

# ─── Service ports ───────────────────────────────────────────────────
API_PORT=4180
REALTIME_PORT=4181

# ─── Auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Resend API key for magic-link emails
RESEND_API_KEY=

# Comma-separated emails that get meta_admin on first registration
UAL_ADMIN_EMAILS=

# ─── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ─── Storage ─────────────────────────────────────────────────────────
STORAGE_BACKEND=filesystem
STORAGE_BASE_PATH=/opt/ual-v2/data

# Where published revisions are written
RELEASES_BASE=/opt/ual-v2/releases

# ─── Encryption ──────────────────────────────────────────────────────
# 32-byte hex key for encrypting stored secrets
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Caddy ───────────────────────────────────────────────────────────
CADDY_ADMIN_URL=http://127.0.0.1:2019

# ─── Porkbun (hosted mode only) ─────────────────────────────────────
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
