#!/usr/bin/env ysh
# =============================================================================
# Porkbun DNS Management
# Creates, updates, or deletes DNS records via Porkbun API v3
# =============================================================================

source-guard dns.ysh || return 0

source $_this_dir/lib/config.ysh

# -----------------------------------------------------------------------------
# API Request Helper
# -----------------------------------------------------------------------------

proc porkbun_request (endpoint, payload) {
  curl -sS -X POST "$[CONFIG.porkbun_api_base]$endpoint" \
    -H 'Content-Type: application/json' \
    -d "$payload"
}

proc check_porkbun_response (response) {
  var status = $(echo "$response" | jq -r '.status // "ERROR"')

  if test "$status" != "SUCCESS" {
    var message = $(echo "$response" | jq -r '.message // "Unknown error"')
    log_error "Porkbun API: $message"
    return 1
  }

  return 0
}

# -----------------------------------------------------------------------------
# DNS Operations
# -----------------------------------------------------------------------------

proc dns_create_a_record (subdomain, ip) {
  # Create or update A record
  # subdomain: relative to base_domain (e.g., 'staging' or '' for apex)
  # ip: IPv4 address

  var domain = CONFIG.base_domain

  log_section "Creating/Updating A Record"
  if test -n "$subdomain" {
    log "$subdomain.$domain -> $ip"
  } else {
    log "$domain -> $ip"
  }

  # Check current DNS
  var fqdn = ''
  if test -n "$subdomain" {
    setvar fqdn = "$subdomain.$domain"
  } else {
    setvar fqdn = "$domain"
  }

  var current_ip = ''
  try {
    setvar current_ip = $(dig +short "$fqdn" '@8.8.8.8' 2>/dev/null | head -1)
  }

  if test "$current_ip" = "$ip" {
    log "DNS already points to $ip - no change needed"
    return 0
  }

  if test -n "$current_ip" {
    log "Current: $current_ip, Target: $ip"
  } else {
    log "Current: (none), Target: $ip"
  }

  # Get secrets
  get_porkbun_secrets

  var auth_payload = $(jq -n \
    --arg apikey "$PKB_API_KEY" \
    --arg secret "$PKB_API_SECRET" \
    '{apikey: $apikey, secretapikey: $secret}')

  # Step 1: DELETE existing record(s) first - Porkbun requires this!
  log "Deleting existing A record(s)..."
  if test -n "$subdomain" {
    var del_response = $(porkbun_request "/dns/deleteByNameType/$domain/A/$subdomain" "$auth_payload")
    log "Delete response: $(echo "$del_response" | jq -r '.status // "unknown"')"
  } else {
    # For apex domain, we need to retrieve and delete conflicting records
    # ALIAS records conflict with A records - must delete them first!
    var records_response = $(porkbun_request "/dns/retrieve/$domain" "$auth_payload")

    # Delete any existing A records at apex
    var apex_a_ids = $(echo "$records_response" | jq -r --arg d "$domain" '.records[] | select(.type == "A" and .name == $d) | .id')
    for record_id in $apex_a_ids {
      if test -n "$record_id" {
        log "Deleting apex A record (id: $record_id)..."
        porkbun_request "/dns/delete/$domain/$record_id" "$auth_payload" > /dev/null 2>&1
      }
    }

    # Delete any ALIAS records at apex - they conflict with A records!
    var apex_alias_ids = $(echo "$records_response" | jq -r --arg d "$domain" '.records[] | select(.type == "ALIAS" and .name == $d) | .id')
    for record_id in $apex_alias_ids {
      if test -n "$record_id" {
        log "Deleting apex ALIAS record (id: $record_id) - conflicts with A record..."
        porkbun_request "/dns/delete/$domain/$record_id" "$auth_payload" > /dev/null 2>&1
      }
    }

    if test -z "$apex_a_ids" && test -z "$apex_alias_ids" {
      log "No conflicting apex records found"
    }
  }

  # Step 2: Wait a moment for delete to propagate in Porkbun's system
  log "Waiting for delete to process..."
  sleep 2

  # Step 3: CREATE new record
  log "Creating new A record..."
  var payload = $(jq -n \
    --arg apikey "$PKB_API_KEY" \
    --arg secret "$PKB_API_SECRET" \
    --arg name "$subdomain" \
    --arg content "$ip" \
    '{
      apikey: $apikey,
      secretapikey: $secret,
      name: $name,
      type: "A",
      content: $content,
      ttl: "300"
    }')

  var response = $(porkbun_request "/dns/create/$domain" "$payload")

  var resp_ok = false
  try {
    check_porkbun_response "$response"
    setvar resp_ok = true
  }
  if test "$resp_ok" = true {
    log_success "A record created"
    return 0
  }

  # Log the actual error for debugging
  log_error "Create failed: $(echo "$response" | jq -r '.message // "unknown error"')"
  return 1
}

proc dns_wait_for_propagation (fqdn, expected_ip; timeout=600, interval=15) {
  log "Waiting for DNS propagation: $fqdn -> $expected_ip"
  log "Checking multiple DNS resolvers for reliable propagation..."

  var start_ts = $(date +%s)

  # Multiple DNS resolvers to check - ACME may use any of these
  var DNS_SERVERS = :| 8.8.8.8 1.1.1.1 9.9.9.9 208.67.222.222 |

  while true {
    var now_ts = $(date +%s)
    var elapsed = now_ts - start_ts

    if (elapsed >= timeout) {
      log_error "DNS propagation timeout after $[timeout / 60] minutes"
      return 1
    }

    # Count how many resolvers see the correct IP
    var propagated_count = 0
    var total_count = 0

    for server in @[DNS_SERVERS] {
      setvar total_count = total_count + 1
      var current = ''
      try {
        setvar current = $(dig +short A "$fqdn" "@$server" 2>/dev/null | head -1)
      }

      if test "$current" = "$expected_ip" {
        setvar propagated_count = propagated_count + 1
        log "[$(date +%H:%M:%S)] ✓ $server: $current"
      } elif test -n "$current" {
        log "[$(date +%H:%M:%S)] ✗ $server: $current (expected: $expected_ip)"
      } else {
        log "[$(date +%H:%M:%S)] ✗ $server: (none)"
      }
    }

    # Require ALL resolvers to agree for robust propagation
    if (propagated_count === total_count) {
      log_success "DNS fully propagated across all $total_count resolvers!"
      return 0
    }

    log "Propagation: $propagated_count/$total_count resolvers. Waiting ${interval}s..."
    sleep $interval
  }
}

proc dns_check_from_server (server_ip, fqdn, expected_ip) {
  # Verify DNS resolves correctly from the SERVER's perspective
  # This is critical because ACME challenges query from external servers
  log "Verifying DNS from server's perspective..."

  var remote_result = ''
  try {
    setvar remote_result = $(ssh -o StrictHostKeyChecking=no -o BatchMode=yes "root@$server_ip" \
      "dig +short A '$fqdn' 2>/dev/null | head -1")
  }

  if test "$remote_result" = "$expected_ip" {
    log_success "Server sees $fqdn -> $expected_ip"
    return 0
  } else {
    log_warning "Server sees $fqdn -> '$remote_result' (expected: $expected_ip)"
    return 1
  }
}

# -----------------------------------------------------------------------------
# High-Level Functions
# -----------------------------------------------------------------------------

proc setup_dns (ip) {
  log_section "Setting up DNS Records"

  var domain = CONFIG.base_domain

  # Staging subdomain
  var staging_sub = CONFIG.staging_subdomain
  if test -z "$staging_sub" {
    setvar staging_sub = "staging"
  }

  log "Creating staging DNS: $staging_sub.$domain -> $ip"
  dns_create_a_record "$staging_sub" "$ip"

  # Production (apex or subdomain)
  var prod_sub = CONFIG.prod_subdomain
  if test -n "$prod_sub" {
    log "Creating production DNS: $prod_sub.$domain -> $ip"
  } else {
    log "Creating production DNS: $domain (apex) -> $ip"
  }
  dns_create_a_record "$prod_sub" "$ip"

  # Wait for propagation across multiple DNS resolvers
  log ""
  log_section "Waiting for DNS Propagation"
  dns_wait_for_propagation "$STAGING_DOMAIN" "$ip"
  dns_wait_for_propagation "$PROD_DOMAIN" "$ip"

  # Final verification from server's perspective (ACME needs this!)
  log ""
  log_section "Verifying DNS from Server"
  dns_check_from_server "$ip" "$STAGING_DOMAIN" "$ip"
  dns_check_from_server "$ip" "$PROD_DOMAIN" "$ip"

  log_success "DNS fully configured and propagated"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc dns_main {
  require_commands curl jq dig

  if (len(ARGV) < 2) {
    echo "Usage: dns.ysh <command> <ip>"
    echo ""
    echo "Commands:"
    echo "  setup <ip>    Create A records for staging + production"
    echo "  wait <ip>     Wait for DNS propagation"
    return 1
  }

  init_config

  var cmd = ARGV[0]
  var ip = ARGV[1]

  case $cmd in
    (setup)
      setup_dns "$ip"
      ;;
    (wait)
      dns_wait_for_propagation "$STAGING_DOMAIN" "$ip"
      dns_wait_for_propagation "$PROD_DOMAIN" "$ip"
      ;;
    (*)
      log_error "Unknown command: $cmd"
      return 1
      ;;
  esac
}

if is-main {
  dns_main
}
