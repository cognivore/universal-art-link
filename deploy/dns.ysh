#!/usr/bin/env ysh
# =============================================================================
# Porkbun DNS Management
# Creates, updates, or deletes DNS records via Porkbun API v3
# =============================================================================

source-guard dns.ysh || return 0

source $_this_dir/lib/config.ysh

# -----------------------------------------------------------------------------
# API Request Helper
# -----------------------------------------------------------------------------

proc porkbun_request (endpoint, payload) {
  curl -sS -X POST "$[CONFIG.porkbun_api_base]$endpoint" \
    -H 'Content-Type: application/json' \
    -d "$payload"
}

proc check_porkbun_response (response) {
  var status = $(echo "$response" | jq -r '.status // "ERROR"')

  if test "$status" != "SUCCESS" {
    var message = $(echo "$response" | jq -r '.message // "Unknown error"')
    log_error "Porkbun API: $message"
    return 1
  }

  return 0
}

# -----------------------------------------------------------------------------
# DNS Operations
# -----------------------------------------------------------------------------

proc dns_create_a_record (subdomain, ip) {
  # Create or update A record
  # subdomain: relative to base_domain (e.g., 'staging' or '' for apex)
  # ip: IPv4 address

  var domain = CONFIG.base_domain

  log_section "Creating/Updating A Record"
  if test -n "$subdomain" {
    log "$subdomain.$domain -> $ip"
  } else {
    log "$domain -> $ip"
  }

  # Check current DNS
  var fqdn = ''
  if test -n "$subdomain" {
    setvar fqdn = "$subdomain.$domain"
  } else {
    setvar fqdn = "$domain"
  }

  var current_ip = ''
  try {
    setvar current_ip = $(dig +short "$fqdn" '@8.8.8.8' 2>/dev/null | head -1)
  }

  if test "$current_ip" = "$ip" {
    log "DNS already points to $ip - no change needed"
    return 0
  }

  if test -n "$current_ip" {
    log "Current: $current_ip, Target: $ip"
  } else {
    log "Current: (none), Target: $ip"
  }

  # Get secrets
  get_porkbun_secrets

  # Delete existing record first
  var auth_payload = $(jq -n \
    --arg apikey "$PKB_API_KEY" \
    --arg secret "$PKB_API_SECRET" \
    '{apikey: $apikey, secretapikey: $secret}')

  if test -n "$subdomain" {
    porkbun_request "/dns/deleteByNameType/$domain/A/$subdomain" "$auth_payload" > /dev/null 2>&1
  } else {
    porkbun_request "/dns/deleteByNameType/$domain/A" "$auth_payload" > /dev/null 2>&1
  }

  # Create new record
  var payload = $(jq -n \
    --arg apikey "$PKB_API_KEY" \
    --arg secret "$PKB_API_SECRET" \
    --arg name "$subdomain" \
    --arg content "$ip" \
    '{
      apikey: $apikey,
      secretapikey: $secret,
      name: $name,
      type: "A",
      content: $content,
      ttl: "300"
    }')

  var response = $(porkbun_request "/dns/create/$domain" "$payload")

  var resp_ok = false
  try {
    check_porkbun_response "$response"
    setvar resp_ok = true
  }
  if test "$resp_ok" = true {
    log_success "A record created"
    return 0
  }

  return 1
}

proc dns_wait_for_propagation (fqdn, expected_ip; timeout=600, interval=10) {
  log "Waiting for DNS propagation: $fqdn -> $expected_ip"

  var start_ts = $(date +%s)

  while true {
    var now_ts = $(date +%s)
    var elapsed = now_ts - start_ts

    if (elapsed >= timeout) {
      log_error "DNS propagation timeout after $[timeout / 60] minutes"
      return 1
    }

    var current = ''
    try {
      setvar current = $(dig +short A "$fqdn" '@8.8.8.8' 2>/dev/null | head -1)
    }

    if test -n "$current" {
      log "[$(date +%H:%M:%S)] Current: $current"
    } else {
      log "[$(date +%H:%M:%S)] Current: (none)"
    }

    if test "$current" = "$expected_ip" {
      log_success "DNS propagation complete!"
      return 0
    }

    sleep $interval
  }
}

# -----------------------------------------------------------------------------
# High-Level Functions
# -----------------------------------------------------------------------------

proc setup_dns (ip) {
  log_section "Setting up DNS Records"

  var domain = CONFIG.base_domain

  # Staging subdomain
  var staging_sub = CONFIG.staging_subdomain
  if test -z "$staging_sub" {
    setvar staging_sub = "staging"
  }

  log "Creating staging DNS: $staging_sub.$domain -> $ip"
  dns_create_a_record "$staging_sub" "$ip"

  # Production (apex or subdomain)
  var prod_sub = CONFIG.prod_subdomain
  if test -n "$prod_sub" {
    log "Creating production DNS: $prod_sub.$domain -> $ip"
  } else {
    log "Creating production DNS: $domain (apex) -> $ip"
  }
  dns_create_a_record "$prod_sub" "$ip"

  # Wait for propagation
  log ""
  dns_wait_for_propagation "$STAGING_DOMAIN" "$ip"
  dns_wait_for_propagation "$PROD_DOMAIN" "$ip"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc dns_main {
  require_commands curl jq dig

  if (len(ARGV) < 2) {
    echo "Usage: dns.ysh <command> <ip>"
    echo ""
    echo "Commands:"
    echo "  setup <ip>    Create A records for staging + production"
    echo "  wait <ip>     Wait for DNS propagation"
    return 1
  }

  init_config

  var cmd = ARGV[0]
  var ip = ARGV[1]

  case $cmd in
    (setup)
      setup_dns "$ip"
      ;;
    (wait)
      dns_wait_for_propagation "$STAGING_DOMAIN" "$ip"
      dns_wait_for_propagation "$PROD_DOMAIN" "$ip"
      ;;
    (*)
      log_error "Unknown command: $cmd"
      return 1
      ;;
  esac
}

if is-main {
  dns_main
}
