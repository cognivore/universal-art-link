[Unit]
Description=UAL v2 API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ual
Group=ual
WorkingDirectory=/opt/ual-v2/code
EnvironmentFile=/opt/ual-v2/.env
Environment=PORT=4180
ExecStart=/usr/bin/node services/api/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ual-v2-api

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ual-v2/data /opt/ual-v2/releases
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
