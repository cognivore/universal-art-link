#!/usr/bin/env ysh
# =============================================================================
# UAL Installation
# Installs and configures UAL staging and production instances
# =============================================================================

source-guard install-ual.ysh || return 0

source $_this_dir/lib/config.ysh
source $_this_dir/lib/hetzner.ysh

# -----------------------------------------------------------------------------
# Environment File Generation
# -----------------------------------------------------------------------------

proc generate_staging_env {
  cat << EOF
# UAL Staging Environment
# Generated by deploy/install-ual.ysh

# Stripe Test Keys
STRIPE_SECRET_KEY_TEST=${STRIPE_SECRET_KEY_TEST:-}
STRIPE_PUBLISHABLE_KEY_TEST=${STRIPE_PUBLISHABLE_KEY_TEST:-}
STRIPE_WEBHOOK_SECRET_TEST=${STRIPE_WEBHOOK_SECRET_TEST:-}

# Auth
UAL_JWT_SECRET=${UAL_JWT_SECRET:-}
UAL_MAGIC_LINK_SECRET=${UAL_MAGIC_LINK_SECRET:-}

# Staging Auth Bypass (Christmas-themed!)
UAL_STAGING_BYPASS=true
UAL_STAGING_JWT=${UAL_STAGING_JWT:-}
EOF
}

proc generate_production_env {
  cat << EOF
# UAL Production Environment
# Generated by deploy/install-ual.ysh

# Stripe Live Keys
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY:-}
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY:-}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET:-}

# Auth (NO staging bypass!)
UAL_JWT_SECRET=${UAL_JWT_SECRET:-}
UAL_MAGIC_LINK_SECRET=${UAL_MAGIC_LINK_SECRET:-}
EOF
}

# -----------------------------------------------------------------------------
# Systemd Service Files
# -----------------------------------------------------------------------------

proc generate_staging_service {
  var port = CONFIG.staging_port

  cat << EOF
[Unit]
Description=UAL Staging Server
After=network.target

[Service]
Type=simple
User=ual
Group=ual
WorkingDirectory=/opt/ual/staging
ExecStart=/usr/bin/node build/cli.js dev --port $port --single-tenant-stripe --stripe-mode=staging
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/ual/staging.log
StandardError=append:/var/log/ual/staging-error.log
EnvironmentFile=/opt/ual/staging/.env

[Install]
WantedBy=multi-user.target
EOF
}

proc generate_production_service {
  var port = CONFIG.prod_port

  cat << EOF
[Unit]
Description=UAL Production Server
After=network.target

[Service]
Type=simple
User=ual
Group=ual
WorkingDirectory=/opt/ual/production
ExecStart=/usr/bin/node build/cli.js dev --port $port --single-tenant-stripe --stripe-mode=production
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/ual/production.log
StandardError=append:/var/log/ual/production-error.log
EnvironmentFile=/opt/ual/production/.env

[Install]
WantedBy=multi-user.target
EOF
}

# -----------------------------------------------------------------------------
# Staging JWT Generation
# -----------------------------------------------------------------------------

proc generate_staging_jwt {
  log "Generating staging bypass JWT..."

  # If already set in env, use it
  if test -n "${UAL_STAGING_JWT:-}" {
    log "Using existing UAL_STAGING_JWT from environment"
    return 0
  }

  # Generate JWT secret if not set
  if test -z "${UAL_JWT_SECRET:-}" {
    export UAL_JWT_SECRET=$(openssl rand -hex 32)
    log "Generated new UAL_JWT_SECRET"
  }

  if test -z "${UAL_MAGIC_LINK_SECRET:-}" {
    export UAL_MAGIC_LINK_SECRET=$(openssl rand -hex 32)
    log "Generated new UAL_MAGIC_LINK_SECRET"
  }

  # Generate the staging JWT using Node.js
  var jwt = $(node -e "
    const crypto = require('crypto');

    const header = { alg: 'HS256', typ: 'JWT' };
    const now = Math.floor(Date.now() / 1000);
    const payload = {
      sub: 'staging@ual.local',
      name: 'Staging Santa',
      is_santa: true,
      iat: now,
      exp: now + (365 * 24 * 60 * 60)
    };

    const base64url = (obj) => Buffer.from(JSON.stringify(obj)).toString('base64url');
    const headerStr = base64url(header);
    const payloadStr = base64url(payload);
    const data = headerStr + '.' + payloadStr;

    const signature = crypto
      .createHmac('sha256', process.env.UAL_JWT_SECRET)
      .update(data)
      .digest('base64url');

    console.log(data + '.' + signature);
  ")

  export UAL_STAGING_JWT="$jwt"
  log_success "Generated staging JWT with is_santa=true claim 🎅"
}

# -----------------------------------------------------------------------------
# Installation
# -----------------------------------------------------------------------------

proc install_ual {
  log_section "Installing UAL"

  if test -z "$SERVER_IP" {
    setglobal SERVER_IP = $(get_server_ip "$[CONFIG.server_name]")
  }

  if test -z "$SERVER_IP" {
    log_error "Server IP not found. Run provision first."
    return 1
  }

  log "Server: $SERVER_IP"

  # Generate staging JWT with is_santa claim
  generate_staging_jwt

  # Generate environment files
  var staging_env = $(generate_staging_env)
  var prod_env = $(generate_production_env)
  var staging_service = $(generate_staging_service)
  var prod_service = $(generate_production_service)

  # Encode for transmission
  var staging_env_b64 = $(echo "$staging_env" | base64)
  var prod_env_b64 = $(echo "$prod_env" | base64)
  var staging_svc_b64 = $(echo "$staging_service" | base64)
  var prod_svc_b64 = $(echo "$prod_service" | base64)

  var repo_url = CONFIG.repo_url
  var repo_branch = CONFIG.repo_branch

  # If GitHub token is available, embed it in the URL for private repo access
  if test -n "${GITHUB_TOKEN:-}" {
    log "Using GitHub token for private repo access..."
    setvar repo_url = $(echo "$repo_url" | sed "s|https://|https://${GITHUB_TOKEN}@|")
  }

  log "Cloning repository and setting up services..."

  ssh_exec "$SERVER_IP" "
    set -e

    echo '=== Installing UAL ==='

    # Clone or update staging
    if [ -d /opt/ual/staging/.git ]; then
      echo 'Updating staging...'
      cd /opt/ual/staging
      git fetch origin
      git reset --hard origin/$repo_branch
    else
      echo 'Cloning to staging...'
      rm -rf /opt/ual/staging
      git clone -b $repo_branch $repo_url /opt/ual/staging
    fi

    # Clone or update production
    if [ -d /opt/ual/production/.git ]; then
      echo 'Updating production...'
      cd /opt/ual/production
      git fetch origin
      git reset --hard origin/$repo_branch
    else
      echo 'Cloning to production...'
      rm -rf /opt/ual/production
      git clone -b $repo_branch $repo_url /opt/ual/production
    fi

    # Install dependencies and build - staging
    echo 'Building staging...'
    cd /opt/ual/staging
    pnpm install --frozen-lockfile
    pnpm build

    # Install dependencies and build - production
    echo 'Building production...'
    cd /opt/ual/production
    pnpm install --frozen-lockfile
    pnpm build

    # Write environment files
    echo '$staging_env_b64' | base64 -d > /opt/ual/staging/.env
    echo '$prod_env_b64' | base64 -d > /opt/ual/production/.env

    # Write systemd service files
    echo '$staging_svc_b64' | base64 -d > /etc/systemd/system/ual-staging.service
    echo '$prod_svc_b64' | base64 -d > /etc/systemd/system/ual-production.service

    # Set permissions
    chown -R ual:ual /opt/ual
    chmod 600 /opt/ual/staging/.env
    chmod 600 /opt/ual/production/.env

    # Reload systemd
    systemctl daemon-reload

    # Enable and start services
    systemctl enable ual-staging
    systemctl enable ual-production
    systemctl restart ual-staging
    systemctl restart ual-production

    # Wait and check
    sleep 5

    echo ''
    echo '=== Service Status ==='
    systemctl is-active ual-staging && echo 'Staging: running' || echo 'Staging: NOT RUNNING'
    systemctl is-active ual-production && echo 'Production: running' || echo 'Production: NOT RUNNING'

    echo ''
    echo '=== Installation Complete ==='
  "

  log_success "UAL installed!"
  log ""
  log "Staging:    http://127.0.0.1:$[CONFIG.staging_port] (via https://$STAGING_DOMAIN)"
  log "Production: http://127.0.0.1:$[CONFIG.prod_port] (via https://$PROD_DOMAIN)"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

if is-main {
  require_commands ssh node openssl

  init_config
  install_ual
}
