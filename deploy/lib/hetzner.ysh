#!/usr/bin/env ysh
# =============================================================================
# Hetzner Cloud API Wrapper
# Idempotent server provisioning via Hetzner Cloud API
# =============================================================================

source-guard lib/hetzner.ysh || return 0

source $_this_dir/config.ysh

const HETZNER_API = 'https://api.hetzner.cloud/v1'

# -----------------------------------------------------------------------------
# API Request Helper
# -----------------------------------------------------------------------------

proc hetzner_request (method, endpoint, payload) {
  var token = $(get_hetzner_token)

  if test -n "$payload" {
    curl -sS -X "$method" "$HETZNER_API$endpoint" \
      -H "Authorization: Bearer $token" \
      -H 'Content-Type: application/json' \
      -d "$payload"
  } else {
    curl -sS -X "$method" "$HETZNER_API$endpoint" \
      -H "Authorization: Bearer $token" \
      -H 'Content-Type: application/json'
  }
}

proc check_hetzner_response (response) {
  var error_val = $(echo "$response" | jq -r '.error // "null"')

  if test "$error_val" != "null" {
    var code = $(echo "$response" | jq -r '.error.code // "unknown"')
    var message = $(echo "$response" | jq -r '.error.message // "Unknown error"')
    log_error "Hetzner API error ($code): $message"
    return 1
  }

  return 0
}

# -----------------------------------------------------------------------------
# SSH Key Management
# -----------------------------------------------------------------------------

proc ensure_ssh_key {
  log "Ensuring SSH key exists in Hetzner..."

  var key_name = "ual-deploy-key"
  var home_dir = $(echo ~)
  var pub_key_file = "$home_dir/.ssh/id_ed25519.pub"

  # Check for existing SSH key file
  if ! test -f "$pub_key_file" {
    setvar pub_key_file = "$home_dir/.ssh/id_rsa.pub"
  }

  if ! test -f "$pub_key_file" {
    log_error "No SSH public key found at ~/.ssh/id_ed25519.pub or ~/.ssh/id_rsa.pub"
    log "Generate one with: ssh-keygen -t ed25519"
    exit 1
  }

  var pub_key = $(cat "$pub_key_file")

  # Check if key already exists
  var response = $(hetzner_request GET "/ssh_keys?name=$key_name" "")
  var existing = $(echo "$response" | jq -r '.ssh_keys[0].id // ""')

  if test -n "$existing" {
    log "SSH key '$key_name' already exists (id: $existing)"
    setglobal SSH_KEY_ID = "$existing"
    return 0
  }

  # Create new SSH key
  var payload = $(jq -n \
    --arg name "$key_name" \
    --arg key "$pub_key" \
    '{name: $name, public_key: $key}')

  var create_response = $(hetzner_request POST "/ssh_keys" "$payload")

  var resp_ok = false
  try {
    check_hetzner_response "$create_response"
    setvar resp_ok = true
  }

  if test "$resp_ok" = true {
    setglobal SSH_KEY_ID = $(echo "$create_response" | jq -r '.ssh_key.id')
    log_success "SSH key created (id: $SSH_KEY_ID)"
    return 0
  }

  # If creation failed due to uniqueness, find the existing key by fingerprint
  var error_code = $(echo "$create_response" | jq -r '.error.code // ""')
  if test "$error_code" = "uniqueness_error" {
    log "SSH key already exists (different name), searching by fingerprint..."
    # Get all SSH keys and find the one matching our public key
    var all_keys = $(hetzner_request GET "/ssh_keys" "")
    # Extract MD5 fingerprint from our public key (Hetzner uses MD5 format)
    var our_fingerprint = $(ssh-keygen -E md5 -lf "$pub_key_file" | awk '{print $2}' | sed 's/^MD5://')
    log "Looking for fingerprint: $our_fingerprint"
    # Find matching key
    setglobal SSH_KEY_ID = $(echo "$all_keys" | jq -r --arg fp "$our_fingerprint" '.ssh_keys[] | select(.fingerprint == $fp) | .id' | head -1)
    if test -n "$SSH_KEY_ID" {
      log "Found existing SSH key with matching fingerprint (id: $SSH_KEY_ID)"
      return 0
    }
  }

  log_error "Failed to create or find SSH key"
  return 1
}

# -----------------------------------------------------------------------------
# Server Operations
# -----------------------------------------------------------------------------

proc get_server_by_name (name) {
  var response = $(hetzner_request GET "/servers?name=$name" "")
  echo "$response" | jq -r '.servers[0] // "null"'
}

proc server_exists (name) {
  var server = $(get_server_by_name "$name")
  test "$server" != "null"
}

proc get_server_ip (name) {
  var server = $(get_server_by_name "$name")
  if test "$server" = "null" {
    echo ""
    return 1
  }
  echo "$server" | jq -r '.public_net.ipv4.ip // ""'
}

proc get_server_id (name) {
  var server = $(get_server_by_name "$name")
  if test "$server" = "null" {
    echo ""
    return 1
  }
  echo "$server" | jq -r '.id // ""'
}

proc create_server {
  log_section "Creating Hetzner Server"

  var server_name = CONFIG.server_name
  log "Server name: $server_name"
  log "Type: $[CONFIG.hetzner_server_type]"
  log "Location: $[CONFIG.hetzner_location]"
  log "Image: $[CONFIG.hetzner_image]"

  # Check if already exists (idempotent)
  var server = $(get_server_by_name "$server_name")
  if test "$server" != "null" {
    log "Server '$server_name' already exists"
    setglobal SERVER_IP = $(echo "$server" | jq -r '.public_net.ipv4.ip // ""')
    setglobal SERVER_ID = $(echo "$server" | jq -r '.id // ""')
    log "IP: $SERVER_IP"
    return 0
  }

  # Ensure SSH key exists
  ensure_ssh_key

  # Create server
  var payload = $(jq -n \
    --arg name "$server_name" \
    --arg type "$[CONFIG.hetzner_server_type]" \
    --arg image "$[CONFIG.hetzner_image]" \
    --arg location "$[CONFIG.hetzner_location]" \
    --argjson ssh_keys "[$SSH_KEY_ID]" \
    '{
      name: $name,
      server_type: $type,
      image: $image,
      location: $location,
      ssh_keys: $ssh_keys,
      start_after_create: true
    }')

  log "Creating server..."
  var response = $(hetzner_request POST "/servers" "$payload")

  var resp_ok = false
  try {
    check_hetzner_response "$response"
    setvar resp_ok = true
  }
  if ! test "$resp_ok" = true {
    return 1
  }

  setglobal SERVER_ID = $(echo "$response" | jq -r '.server.id')
  setglobal SERVER_IP = $(echo "$response" | jq -r '.server.public_net.ipv4.ip')

  log_success "Server created!"
  log "  ID: $SERVER_ID"
  log "  IP: $SERVER_IP"

  # Wait for server to be running
  wait_for_server_running "$server_name"
}

proc wait_for_server_running (name; max_attempts=30, interval=10) {
  log "Waiting for server to be running..."

  var attempt = 1

  while (attempt <= max_attempts) {
    var server = $(get_server_by_name "$name")
    var status = $(echo "$server" | jq -r '.status // "unknown"')

    log "Server status: $status (attempt $attempt/$max_attempts)"

    if test "$status" = "running" {
      log_success "Server is running!"
      return 0
    }

    sleep $interval
    setvar attempt = attempt + 1
  }

  log_error "Timeout waiting for server to start"
  return 1
}

proc delete_server (name) {
  log "Deleting server '$name'..."

  var server_id = $(get_server_id "$name")
  if test -z "$server_id" {
    log "Server '$name' does not exist"
    return 0
  }

  var response = $(hetzner_request DELETE "/servers/$server_id" "")

  var resp_ok = false
  try {
    check_hetzner_response "$response"
    setvar resp_ok = true
  }
  if ! test "$resp_ok" = true {
    return 1
  }

  log_success "Server deleted"
}

# -----------------------------------------------------------------------------
# SSH Helpers
# -----------------------------------------------------------------------------

proc wait_for_ssh (ip; max_attempts=30, interval=10) {
  log "Waiting for SSH to become available on $ip..."

  var attempt = 1

  while (attempt <= max_attempts) {
    log "SSH attempt $attempt/$max_attempts..."

    var ssh_result = ''
    try {
      setvar ssh_result = $(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes "root@$ip" "echo 'SSH ready'" 2>/dev/null)
    }

    if test "$ssh_result" = "SSH ready" {
      log_success "SSH connection established!"
      return 0
    }

    sleep $interval
    setvar attempt = attempt + 1
  }

  log_error "SSH connection failed after $max_attempts attempts"
  return 1
}

proc ssh_exec (ip, command) {
  ssh -o StrictHostKeyChecking=no -o BatchMode=yes "root@$ip" "$command"
}

proc scp_file (ip, local_path, remote_path) {
  scp -o StrictHostKeyChecking=no "$local_path" "root@$ip:$remote_path"
}
