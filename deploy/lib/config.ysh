#!/usr/bin/env ysh
# =============================================================================
# UAL Deployment Configuration
# Declarative configuration for Hetzner + Porkbun deployment
# =============================================================================

# Prevent double-sourcing
source-guard lib/config.ysh || return 0

# -----------------------------------------------------------------------------
# Configuration as Data
# -----------------------------------------------------------------------------

const BASE_CONFIG = {
  # Hetzner Cloud
  hetzner_server_type: 'cx22',
  hetzner_location: 'fsn1',
  hetzner_image: 'ubuntu-24.04',
  server_name: 'ual-server',

  # Domains (customize via env)
  base_domain: 'example.com',
  staging_subdomain: 'staging',
  prod_subdomain: '',

  # Porkbun
  porkbun_api_base: 'https://api.porkbun.com/api/json/v3',

  # UAL Ports
  staging_port: 4173,
  prod_port: 4174,

  # DNS
  dns_timeout_seconds: 600,
  dns_poll_interval: 10,

  # Git repo
  repo_url: 'https://github.com/user/universal-artistic-link.git',
  repo_branch: 'main',
}

# -----------------------------------------------------------------------------
# Active Configuration (mutable copy)
# -----------------------------------------------------------------------------

setglobal DEPLOYMENT_PREFIX = ''
setglobal CONFIG = BASE_CONFIG

# Derived domains (computed after config is set)
setglobal STAGING_DOMAIN = ''
setglobal PROD_DOMAIN = ''

# Server state (set during provisioning)
setglobal SERVER_IP = ''
setglobal SERVER_ID = ''

# Porkbun credentials
setglobal PKB_API_KEY = ''
setglobal PKB_API_SECRET = ''

# SSH Key ID
setglobal SSH_KEY_ID = ''

# -----------------------------------------------------------------------------
# Configuration Helpers
# -----------------------------------------------------------------------------

proc compute_domains {
  var base = CONFIG.base_domain

  if test -n "$[CONFIG.staging_subdomain]" {
    setglobal STAGING_DOMAIN = "$[CONFIG.staging_subdomain].$base"
  } else {
    setglobal STAGING_DOMAIN = "staging.$base"
  }

  if test -n "$[CONFIG.prod_subdomain]" {
    setglobal PROD_DOMAIN = "$[CONFIG.prod_subdomain].$base"
  } else {
    setglobal PROD_DOMAIN = "$base"
  }
}

proc set_config_from_env {
  # Override config from environment variables if present
  if test -n "${UAL_BASE_DOMAIN:-}" {
    var domain_json = $(json write (CONFIG))
    var domain_updated = $(echo "$domain_json" | jq --arg domain "$UAL_BASE_DOMAIN" '.base_domain = $domain')
    var domain_config
    json read (&domain_config) <<< $domain_updated
    setglobal CONFIG = domain_config
  }

  if test -n "${UAL_SERVER_NAME:-}" {
    var name_json = $(json write (CONFIG))
    var name_updated = $(echo "$name_json" | jq --arg name "$UAL_SERVER_NAME" '.server_name = $name')
    var name_config
    json read (&name_config) <<< $name_updated
    setglobal CONFIG = name_config
  }

  compute_domains
}

# -----------------------------------------------------------------------------
# Utility Functions
# -----------------------------------------------------------------------------

proc log (msg) {
  echo "[$(date '+%H:%M:%S')] $msg"
}

proc log_section (title) {
  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════════"
  echo " $title"
  echo "═══════════════════════════════════════════════════════════════════════════════"
}

proc log_warning (msg) {
  echo "[$(date '+%H:%M:%S')] ⚠️  WARNING: $msg"
}

proc log_error (msg) {
  echo "[$(date '+%H:%M:%S')] ❌ ERROR: $msg" >&2
}

proc log_success (msg) {
  echo "[$(date '+%H:%M:%S')] ✅ $msg"
}

proc require_command (cmd) {
  if ! command -v $cmd > /dev/null 2>&1 {
    log_error "Required command '$cmd' not found."
    exit 1
  }
}

proc require_commands {
  for cmd in @ARGV {
    require_command $cmd
  }
}

# -----------------------------------------------------------------------------
# Environment Variable Loading
# -----------------------------------------------------------------------------

proc load_env_file {
  var env_file = "$_this_dir/../.env"

  if test -f "$env_file" {
    log "Loading environment from .env file..."
    # Parse .env and set each variable as a shell variable
    # Filter to only UAL-related variables
    var env_vars = $(bash -c "set -a; source '$env_file' 2>/dev/null; env" | grep -E '^(HETZNER_|PORKBUN_|UAL_|STRIPE_)')

    # Set each variable using eval with proper quoting
    for line in @(echo "$env_vars") {
      if test -n "$line" {
        var var_name = $(echo "$line" | cut -d= -f1)
        var var_value = $(echo "$line" | cut -d= -f2-)
        # Use eval with quoted value to set the variable dynamically
        eval "setglobal $var_name = \"$var_value\""
      }
    }
  } else {
    log_warning ".env file not found at $env_file"
  }
}

proc require_env (var_name) {
  var value = ''
  eval "value=\${$var_name:-}"

  if test -z "$value" {
    log_error "Required environment variable $var_name is not set"
    log "Please set it in .env file or export it"
    exit 1
  }
}

proc get_env (var_name) {
  eval "echo \${$var_name:-}"
}

# -----------------------------------------------------------------------------
# Secrets from Environment
# -----------------------------------------------------------------------------

proc get_hetzner_token {
  require_env HETZNER_API_TOKEN
  echo "$HETZNER_API_TOKEN"
}

proc get_porkbun_secrets {
  require_env PORKBUN_API_KEY
  require_env PORKBUN_API_SECRET
  setglobal PKB_API_KEY = "$PORKBUN_API_KEY"
  setglobal PKB_API_SECRET = "$PORKBUN_API_SECRET"
}

# -----------------------------------------------------------------------------
# Initialization
# -----------------------------------------------------------------------------

proc init_config {
  load_env_file
  set_config_from_env
  compute_domains

  log "Configuration initialized:"
  log "  Server name:    $[CONFIG.server_name]"
  log "  Staging domain: $STAGING_DOMAIN"
  log "  Prod domain:    $PROD_DOMAIN"
}
