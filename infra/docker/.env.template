# Postgres
POSTGRES_DB=ual
POSTGRES_USER=ual
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ual:change_me_in_production@localhost:5432/ual

# Platform mode: "hosted" or "self_host"
UAL_MODE=self_host

# Base domain for hosted mode subdomain provisioning
UAL_BASE_DOMAIN=example.com

# Porkbun API (hosted mode only)
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# Caddy Admin API
CADDY_ADMIN_URL=http://127.0.0.1:2019

# Auth
JWT_SECRET=change_me_in_production
RESEND_API_KEY=
UAL_ADMIN_EMAILS=admin@example.com

# Stripe (platform-level, for Connect mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Object storage (self_host uses filesystem by default)
STORAGE_BACKEND=filesystem
STORAGE_BASE_PATH=./data

# S3 (hosted mode)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Encryption key for stored secrets (32-byte hex)
ENCRYPTION_KEY=

# Imgproxy (optional)
IMGPROXY_URL=http://localhost:8081
