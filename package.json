    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "yjs": "^13.6.29"
  },
  "dependencies": {
    "pg": "^8.18.0"
  }
}
