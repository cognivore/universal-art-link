{
  "name": "universal-artistic-link",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "description": "Multi-tenant browser-only CMS with CRDT editing, atomic publish, and Stripe integration.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
