{
  "site": {
    "title": "Site settings",
    "fields": [
      { "key": "siteTitle", "label": "Site title", "type": "text" },
      { "key": "siteDescription", "label": "Site description", "type": "textarea" },
      { "key": "baseUrl", "label": "Base URL", "type": "text", "placeholder": "/" },
      { "key": "theme.mode", "label": "Theme mode", "type": "select", "options": ["light", "dark"] },
      { "key": "theme.background", "label": "Background color", "type": "color" },
      { "key": "theme.foreground", "label": "Foreground color", "type": "color" },
      { "key": "theme.accent", "label": "Accent color", "type": "color" },
      { "key": "theme.muted", "label": "Muted color", "type": "color" }
    ],
    "lists": [
      {
        "key": "navigation",
        "label": "Navigation links",
        "itemLabel": "Link",
        "fields": [
          { "key": "label", "label": "Label", "type": "text" },
          { "key": "href", "label": "Href", "type": "text" }
        ]
      },
      {
        "key": "socialLinks",
        "label": "Social links",
        "itemLabel": "Link",
        "fields": [
          { "key": "label", "label": "Label", "type": "text" },
          { "key": "href", "label": "Href", "type": "text" }
        ]
      }
    ]
  },
  "page": {
    "title": "Page settings",
    "fields": [
      { "key": "title", "label": "Page title", "type": "text" },
      { "key": "slug", "label": "Slug", "type": "text", "placeholder": "/work" },
      { "key": "description", "label": "Meta description", "type": "textarea" },
      {
        "key": "layout",
        "label": "Layout",
        "type": "select",
        "options": ["default", "project", "index-grid", "journal"]
      }
    ],
    "defaults": {
      "title": "Untitled page",
      "slug": "/untitled",
      "description": "",
      "layout": "default",
      "sections": [],
      "journalPosts": []
    }
  },
  "sections": [
    {
      "type": "hero",
      "label": "Hero intro",
      "description": "Split layout headline with media and call-to-actions.",
      "defaults": {
        "type": "hero",
        "title": "New hero",
        "subtitle": "",
        "body": ""
      },
      "fields": [
        { "key": "kicker", "label": "Kicker", "type": "text" },
        { "key": "title", "label": "Title", "type": "text" },
        { "key": "subtitle", "label": "Subtitle", "type": "textarea" },
        { "key": "body", "label": "Body", "type": "textarea" }
      ],
      "groups": [
        {
          "key": "media",
          "label": "Hero media",
          "optional": true,
          "fields": [
            { "key": "src", "label": "Image URL", "type": "text" },
            { "key": "alt", "label": "Alt text", "type": "text" }
          ]
        },
        {
          "key": "primaryCta",
          "label": "Primary CTA",
          "optional": true,
          "fields": [
            { "key": "label", "label": "Label", "type": "text" },
            { "key": "href", "label": "Link", "type": "text" }
          ]
        },
        {
          "key": "secondaryCta",
          "label": "Secondary CTA",
          "optional": true,
          "fields": [
            { "key": "label", "label": "Label", "type": "text" },
            { "key": "href", "label": "Link", "type": "text" }
          ]
        }
      ]
    },
    {
      "type": "projects-grid",
      "label": "Projects grid",
      "description": "Image-led portfolio grid.",
      "defaults": {
        "type": "projects-grid",
        "title": "Recent work",
        "intro": "",
        "projects": []
      },
      "fields": [
        { "key": "title", "label": "Section title", "type": "text" },
        { "key": "intro", "label": "Intro", "type": "textarea" }
      ],
      "lists": [
        {
          "key": "projects",
          "label": "Projects",
          "itemLabel": "Project",
          "fields": [
            { "key": "title", "label": "Title", "type": "text" },
            { "key": "role", "label": "Role", "type": "text" },
            { "key": "year", "label": "Year", "type": "text" },
            {
              "key": "span",
              "label": "Span",
              "type": "select",
              "options": ["standard", "wide", "tall"]
            },
            { "key": "slug", "label": "Internal slug", "type": "text", "placeholder": "/project" },
            { "key": "url", "label": "External URL", "type": "text" }
          ],
          "groups": [
            {
              "key": "coverImage",
              "label": "Cover image",
              "fields": [
                { "key": "src", "label": "Image URL", "type": "text" },
                { "key": "alt", "label": "Alt text", "type": "text" },
                { "key": "focalPoint", "label": "Focal point", "type": "select", "options": ["left", "center", "right"] }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "text-columns",
      "label": "Text columns",
      "defaults": {
        "type": "text-columns",
        "title": "",
        "columns": [{ "label": "", "body": "" }]
      },
      "fields": [{ "key": "title", "label": "Title", "type": "text" }],
      "lists": [
        {
          "key": "columns",
          "label": "Columns",
          "itemLabel": "Column",
          "fields": [
            { "key": "label", "label": "Label", "type": "text" },
            { "key": "body", "label": "Body", "type": "textarea" }
          ]
        }
      ]
    },
    {
      "type": "list-section",
      "label": "List section",
      "defaults": {
        "type": "list-section",
        "title": "Highlights",
        "items": []
      },
      "fields": [{ "key": "title", "label": "Title", "type": "text" }],
      "lists": [
        {
          "key": "items",
          "label": "Items",
          "itemLabel": "Entry",
          "fields": [
            { "key": "label", "label": "Label", "type": "text" },
            { "key": "detail", "label": "Detail", "type": "text" },
            { "key": "url", "label": "Link (optional)", "type": "text" }
          ]
        }
      ]
    },
    {
      "type": "contact",
      "label": "Contact",
      "defaults": {
        "type": "contact",
        "title": "Contact",
        "body": "",
        "email": "studio@example.com"
      },
      "fields": [
        { "key": "title", "label": "Title", "type": "text" },
        { "key": "body", "label": "Body", "type": "textarea" },
        { "key": "email", "label": "Email", "type": "text" },
        { "key": "formAction", "label": "Form action", "type": "text" }
      ]
    },
    {
      "type": "blog-roll",
      "label": "Journal entries",
      "description": "Curated list of editorial posts managed via the Edit post tab.",
      "mode": "blog-roll",
      "defaults": {
        "type": "blog-roll",
        "title": "Entries",
        "intro": "",
        "posts": []
      },
      "fields": [
        { "key": "title", "label": "Title", "type": "text" },
        { "key": "intro", "label": "Intro", "type": "textarea" }
      ],
      "lists": [
        {
          "key": "posts",
          "label": "Posts",
          "itemLabel": "Post reference",
          "fields": [
            { "key": "postId", "label": "Post ID", "type": "text" },
            {
              "key": "featured",
              "label": "Featured",
              "type": "checkbox",
              "default": false
            }
          ]
        }
      ]
    },
    {
      "type": "single-project",
      "label": "Single project",
      "description": "Editorial case study with structured hero data and stacked blocks.",
      "mode": "project-builder",
      "defaults": {
        "type": "single-project",
        "title": "Project headline",
        "role": "Role",
        "year": "2025",
        "tags": [],
        "credits": [],
        "blocks": []
      }
    }
  ]
}


