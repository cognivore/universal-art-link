<header class="site-header{{#if stacked}} site-header--stacked{{/if}}">
  <div class="site-header__brand">
    <a class="logo" href="{{assets.base}}/">{{site.siteTitle}}</a>
    {{#if showDescription}}
    <p class="micro-label muted">{{site.siteDescription}}</p>
    {{/if}}
  </div>
  <nav class="site-nav{{#if stacked}} site-nav--stacked{{/if}}">
    {{#each navigation}}
    <a href="{{href}}" class="nav-link {{#if active}}is-active{{/if}}">{{label}}</a>
    {{/each}}
  </nav>
  <button class="nav-toggle" data-nav-toggle>Menu</button>
</header>

