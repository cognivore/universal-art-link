#!/usr/bin/env ysh
# =============================================================================
# Iocaine Load Test Runner
# Pure test execution - assumes infrastructure is already deployed via deploy.ysh
# =============================================================================

# Save ARGV before sources consume it
const SCRIPT_ARGS = ARGV

source $_this_dir/lib/config.ysh
source $_this_dir/lib/aws-config.ysh
source $_this_dir/swarm/provision-swarm.ysh
source $_this_dir/swarm/coordinator.ysh
source $_this_dir/swarm/collect-results.ysh

# -----------------------------------------------------------------------------
# Argument Parsing
# -----------------------------------------------------------------------------

# Defaults
setglobal CLEANUP_AFTER_TEST = false
setglobal TEST_DURATION = SWARM_CONFIG.test_duration
setglobal VUS_COUNT = SWARM_CONFIG.vus_per_scenario
setglobal PARSED_PREFIX = ''
setglobal PARSED_DURATION = ''
setglobal PARSED_VUS = ''

proc parse_args {
  var expect_prefix_value = false

  for arg in @SCRIPT_ARGS {
    if test "$expect_prefix_value" = true {
      setglobal PARSED_PREFIX = arg
      setvar expect_prefix_value = false
      continue
    }

    case $arg in
      (--prefix)
        setvar expect_prefix_value = true
        ;;
      (--prefix=*)
        setglobal PARSED_PREFIX = $(echo "$arg" | cut -d'=' -f2-)
        ;;
      (--cleanup-after-test)
        setglobal CLEANUP_AFTER_TEST = true
        ;;
      (--duration=*)
        var dur_val = $(echo "$arg" | sed 's/--duration=//')
        setglobal PARSED_DURATION = dur_val
        ;;
      (--vus=*)
        var vus_val = $(echo "$arg" | sed 's/--vus=//')
        setglobal PARSED_VUS = vus_val
        ;;
      (run)
        setglobal COMMAND = 'run'
        ;;
      (report)
        setglobal COMMAND = 'report'
        ;;
      (status)
        setglobal COMMAND = 'status'
        ;;
      (*)
        # Other args handled separately
        ;;
    esac
  }

  # Apply prefix after parsing
  set_deployment_prefix "$PARSED_PREFIX"

  # Re-read defaults from (potentially prefixed) config, but preserve user overrides
  if test -z "$PARSED_DURATION" {
    setglobal TEST_DURATION = SWARM_CONFIG.test_duration
  } else {
    setglobal TEST_DURATION = PARSED_DURATION
  }

  if test -z "$PARSED_VUS" {
    setglobal VUS_COUNT = SWARM_CONFIG.vus_per_scenario
  } else {
    setglobal VUS_COUNT = PARSED_VUS
  }
}

# -----------------------------------------------------------------------------
# Infrastructure Verification
# -----------------------------------------------------------------------------

proc verify_infrastructure {
  log_section "Verifying Infrastructure"

  var all_ok = true

  # Check coordinator
  log "Checking coordinator..."
  check_coordinator_exists
  if (COORDINATOR_EXISTS) {
    get_coordinator_ip
    log "  Coordinator: $COORDINATOR_IP ✓"
  } else {
    log "  Coordinator: NOT FOUND ✗"
    setvar all_ok = false
  }

  # Check swarm
  log "Checking swarm..."
  get_swarm_instances
  if test -n "$SWARM_INSTANCES" {
    var count = $(echo "$SWARM_INSTANCES" | wc -l | tr -d ' ')
    log "  Swarm: $count instance(s) ✓"
  } else {
    log "  Swarm: NOT FOUND ✗"
    setvar all_ok = false
  }

  # Check CloudFront using custom domain
  log "Checking CloudFront..."
  set_aws_region
  try {
    ensure_aws_auth
    get_cloudfront_distribution_id
    if test -n "$CLOUDFRONT_DISTRIBUTION_ID" {
      # Use custom domain instead of raw CloudFront URL
      var cf_custom_domain = AWS_CONFIG.cloudfront.domain
      log "  CloudFront: $cf_custom_domain ✓"
      setglobal TARGET_URL = "https://$cf_custom_domain"
    } else {
      log "  CloudFront: NOT FOUND ✗"
      setvar all_ok = false
    }
  }

  log ""

  if test "$all_ok" = false {
    log "ERROR: Infrastructure not fully deployed."
    log "Run './deploy.ysh' first to set up all components."
    exit 1
  }

  log "All infrastructure verified ✓"
}

# -----------------------------------------------------------------------------
# Test Execution
# -----------------------------------------------------------------------------

proc trigger_tests_on_swarm {
  log_section "Triggering Load Tests"

  log "Duration: $TEST_DURATION"
  log "VUs per scenario: $VUS_COUNT"
  log "Target: $TARGET_URL"
  log ""

  # Get instance list with zones (tab-separated for easier parsing)
  var instance_data = $(gcloud compute instances list \
    --project=$[CONFIG.project] \
    --filter="name~'^$[SWARM_CONFIG.instance_prefix]-'" \
    --format='value(name,zone)' 2>/dev/null)

  if test -z "$instance_data" {
    log "ERROR: No swarm instances found"
    return 1
  }

  var tmp_instances = $(mktemp)
  echo "$instance_data" > $tmp_instances
  var started = 0

  # Process each instance - gcloud value format uses tabs
  while read line {
    if test -z "$line" {
      continue
    }

    # Parse tab-separated name and zone
    var instance = $(echo "$line" | cut -f1)
    var zone = $(echo "$line" | cut -f2)

    if test -z "$instance" || test -z "$zone" {
      log "WARNING: Could not parse: $line"
      continue
    }

    log "Starting test on $instance ($zone)..."

    # Update config with current parameters and start test
    # Note: < /dev/null prevents gcloud ssh from consuming stdin
    # Use sed -i to REPLACE values (not append) so overrides actually work
    gcloud compute ssh "$instance" \
      --project=$[CONFIG.project] \
      --zone="$zone" \
      --ssh-flag="-o StrictHostKeyChecking=no" \
      --command="
        sed -i 's|^TEST_DURATION=.*|TEST_DURATION=\"$TEST_DURATION\"|' /opt/loadtest/config.env
        sed -i 's|^VUS_PER_SCENARIO=.*|VUS_PER_SCENARIO=\"$VUS_COUNT\"|' /opt/loadtest/config.env
        sed -i 's|^TARGET_URL=.*|TARGET_URL=\"$TARGET_URL\"|' /opt/loadtest/config.env
        nohup /opt/loadtest/run-test.sh > /tmp/loadtest-\$(date +%s).log 2>&1 &
      " < /dev/null 2>/dev/null

    log "  $instance: test started"
    setvar started = started + 1
  } < $tmp_instances

  rm -f $tmp_instances

  log ""
  log "Started tests on $started worker(s)"
}

proc wait_for_tests {
  # Wait for test duration plus buffer
  log_section "Waiting for Tests to Complete"

  # Parse duration (e.g., "60s", "2m")
  var duration_str = TEST_DURATION
  var duration_sec = 60  # default

  case $duration_str in
    *s)
      setvar duration_sec = $(echo "$duration_str" | sed 's/s//')
      ;;
    *m)
      var mins = $(echo "$duration_str" | sed 's/m//')
      setvar duration_sec = mins * 60
      ;;
  esac

  var wait_time = duration_sec + 15  # Add buffer
  log "Waiting ${wait_time}s for tests to complete..."
  log ""
  log "Watch live metrics at:"
  log "  http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.grafana_port]"
  log ""

  sleep $wait_time

  log "Tests should be complete"
}

proc show_live_dashboard {
  log ""
  log "╔══════════════════════════════════════════════════════════════╗"
  log "║                    LIVE METRICS DASHBOARD                    ║"
  log "╠══════════════════════════════════════════════════════════════╣"
  log "║                                                              ║"
  log "║  Grafana: https://$[COORDINATOR_CONFIG.domain]/grafana"
  log "║  Direct:  http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.grafana_port]"
  log "║  Login:   admin / admin                                      ║"
  log "║                                                              ║"
  log "╚══════════════════════════════════════════════════════════════╝"
  log ""

  # Try to open automatically (prefer HTTPS domain)
  if command -v open > /dev/null 2>&1 {
    open "https://$[COORDINATOR_CONFIG.domain]/grafana"
  } elif command -v xdg-open > /dev/null 2>&1 {
    xdg-open "https://$[COORDINATOR_CONFIG.domain]/grafana"
  }
}

proc cleanup_swarm {
  log_section "Cleaning Up Swarm"

  source $_this_dir/swarm/destroy-swarm.ysh
  export AUTO_CONFIRM=yes
  destroy_swarm

  log "Swarm cleaned up"
}

# -----------------------------------------------------------------------------
# Run Command
# -----------------------------------------------------------------------------

proc loadtest_run {
  log_section "Iocaine Load Test"
  log ""
  log "Parameters:"
  log "  Duration:            $TEST_DURATION"
  log "  VUs per scenario:    $VUS_COUNT"
  log "  Cleanup after test:  $CLEANUP_AFTER_TEST"
  log ""

  # Verify infrastructure exists
  verify_infrastructure

  # Show dashboard URL
  show_live_dashboard

  # Trigger tests on all workers
  trigger_tests_on_swarm

  # Wait for tests to complete
  wait_for_tests

  # Collect results
  log_section "Collecting Results"
  collect_all_results

  log ""
  log "Load test complete!"
  log "Results saved to: $RESULTS_DIR"
  log ""

  # Cleanup if requested
  if test "$CLEANUP_AFTER_TEST" = true {
    cleanup_swarm
  }

  log ""
  log "Next steps:"
  log "  ./loadtest.ysh report    # Generate HTML report"
  log "  ./loadtest.ysh status    # Check infrastructure status"

  if test "$CLEANUP_AFTER_TEST" = false {
    log "  ./loadtest.ysh run       # Run another test"
  }
}

# -----------------------------------------------------------------------------
# Report Command
# -----------------------------------------------------------------------------

proc loadtest_report {
  var results_dir = ${1:-}

  log_section "Generating Load Test Report"

  if test -z "$results_dir" {
    # Find latest results
    setvar results_dir = $(ls -t "$_this_dir/swarm/results" 2>/dev/null | head -1)

    if test -z "$results_dir" {
      log "ERROR: No results found. Run 'loadtest.ysh run' first."
      exit 1
    }

    setvar results_dir = "$_this_dir/swarm/results/$results_dir"
  }

  log "Results directory: $results_dir"

  # Check for aggregate.json
  var aggregate_file = "$results_dir/aggregate.json"

  if ! test -f "$aggregate_file" {
    log "Aggregate file not found, generating..."
    aggregate_results "$results_dir"
  }

  # Copy report template
  var report_template = "$_this_dir/swarm/report.html"
  var report_output = "$results_dir/report.html"

  # Create report with embedded data
  cat > "$report_output" << 'HTML_START'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iocaine Load Test Report</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
HTML_START

  # Append the rest of the template and replace sample data with actual data
  sed -n '/<style>/,/<\/html>/p' "$report_template" | \
    sed "s/const sampleData = .*/const sampleData = $(cat $aggregate_file);/" >> "$report_output"

  log ""
  log "Report generated: $report_output"
  log ""

  # Try to open automatically
  if command -v open > /dev/null 2>&1 {
    open "$report_output"
  } elif command -v xdg-open > /dev/null 2>&1 {
    xdg-open "$report_output"
  }
}

# -----------------------------------------------------------------------------
# Status Command
# -----------------------------------------------------------------------------

proc loadtest_status {
  log_section "Load Test Infrastructure Status"

  # CloudFront
  log ""
  log "=== CloudFront ==="
  set_aws_region
  try {
    ensure_aws_auth
    get_cloudfront_distribution_id

    if test -n "$CLOUDFRONT_DISTRIBUTION_ID" {
      var info = $(aws cloudfront get-distribution \
        --id "$CLOUDFRONT_DISTRIBUTION_ID" \
        --output json 2>/dev/null)
      var domain = $(echo "$info" | jq -r '.Distribution.DomainName')
      var status = $(echo "$info" | jq -r '.Distribution.Status')
      log "Distribution: $CLOUDFRONT_DISTRIBUTION_ID"
      log "Domain:       $domain"
      log "Status:       $status"
    } else {
      log "No CloudFront distribution found"
    }
  }

  # Coordinator
  log ""
  log "=== Coordinator ==="
  check_coordinator_exists
  if (COORDINATOR_EXISTS) {
    get_coordinator_ip
    log "Instance: $[COORDINATOR_CONFIG.instance_name]"
    log "IP:       $COORDINATOR_IP"
    log "Domain:   $[COORDINATOR_CONFIG.domain]"
    log "Grafana:  https://$[COORDINATOR_CONFIG.domain]/grafana"
    log "          http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.grafana_port]"
  } else {
    log "Coordinator not deployed"
  }

  # Iocaine instance
  log ""
  log "=== Iocaine Instance ==="
  var iocaine_status = ''
  try {
    setvar iocaine_status = $(gcloud compute instances describe $[CONFIG.instance_name] \
      --project=$[CONFIG.project] \
      --zone=$[CONFIG.zone] \
      --format='value(status)' 2>/dev/null)
  }
  if test -n "$iocaine_status" {
    log "Instance: $[CONFIG.instance_name]"
    log "Status:   $iocaine_status"
    log "Domain:   $[CONFIG.domain]"
  } else {
    log "Iocaine instance not found"
  }

  # Swarm
  log ""
  log "=== Load Test Swarm ==="
  list_swarm
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc loadtest_main {
  require_commands gcloud aws jq curl

  # Set default command
  setglobal COMMAND = 'help'

  # Parse arguments (uses global SCRIPT_ARGS) and apply prefix
  parse_args

  case $COMMAND in
    run)
      loadtest_run
      ;;
    report)
      loadtest_report ${1:-}
      ;;
    status)
      loadtest_status
      ;;
    help|*)
      echo "Iocaine Load Test Runner"
      echo ""
      echo "Usage: loadtest.ysh <command> [options]"
      echo ""
      echo "Commands:"
      echo "  run       Execute load test via CloudFront"
      echo "  report    Generate HTML report from latest results"
      echo "  status    Show infrastructure status"
      echo ""
      echo "Options:"
      echo "  --prefix <value>       Use a prefixed deployment (same prefix as deploy.ysh)"
      echo "  --prefix=value         Same as above"
      echo ""
      echo "  --duration <time>      Test duration (default: $[SWARM_CONFIG.test_duration])"
      echo "                         Examples: 60s, 2m, 5m"
      echo ""
      echo "  --vus <count>          Virtual users per scenario (default: $[SWARM_CONFIG.vus_per_scenario])"
      echo ""
      echo "  --cleanup-after-test   Delete swarm VMs after test (default: false)"
      echo "                         Keeps coordinator + iocaine + CloudFront"
      echo ""
      echo "Examples:"
      echo "  ./loadtest.ysh run"
      echo "  ./loadtest.ysh run --prefix 20251127"
      echo "  ./loadtest.ysh run --duration 120s --vus 100"
      echo "  ./loadtest.ysh run --cleanup-after-test"
      echo "  ./loadtest.ysh report"
      echo ""
      echo "Workflow:"
      echo "  1. ./deploy.ysh --prefix 20251127   # Deploy prefixed infrastructure"
      echo "  2. ./loadtest.ysh run --prefix 20251127"
      echo "  3. ./destroy.ysh --full --prefix 20251127"
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------

if is-main {
  loadtest_main
}
