#!/usr/bin/env ysh
# =============================================================================
# Load Test Swarm Provisioning
# Creates distributed load generators across multiple GCP zones
# Workers output metrics to coordinator's InfluxDB for live Grafana dashboards
# =============================================================================

source-guard swarm/provision-swarm.ysh || return 0

source $_this_dir/../lib/config.ysh

# -----------------------------------------------------------------------------
# Swarm Instance Management
# -----------------------------------------------------------------------------

proc get_swarm_instances {
  # List all load generator instances
  # Returns: sets SWARM_INSTANCES as a list of instance names

  var prefix = SWARM_CONFIG.instance_prefix

  var instances = $(gcloud compute instances list \
    --project=$[CONFIG.project] \
    --filter="name~'^$prefix-'" \
    --format='value(name)' 2>/dev/null)

  setglobal SWARM_INSTANCES = "$instances"
}

proc check_instance_exists (instance_name, zone) {
  # Check if a specific instance exists
  # Sets: INSTANCE_EXISTS global (true/false)
  var exists = ''
  try {
    setvar exists = $(gcloud compute instances describe "$instance_name" \
      --project=$[CONFIG.project] \
      --zone="$zone" \
      --format='value(name)' 2>/dev/null)
  }

  if test -n "$exists" {
    setglobal INSTANCE_EXISTS = true
  } else {
    setglobal INSTANCE_EXISTS = false
  }
}

# -----------------------------------------------------------------------------
# Startup Script Preparation
# -----------------------------------------------------------------------------

proc prepare_swarm_startup_script (target_url, coordinator_ip, worker_id) {
  # Prepare the startup script for load generator VMs
  # Substitutes the target URL, coordinator IP, and worker ID

  var template = "$_this_dir/swarm/loadtest-startup.sh"

  if ! test -f "$template" {
    log "ERROR: Startup script template not found at $template"
    exit 1
  }

  var tmp_file = $(mktemp)

  # Get config values as local vars for sed
  var test_duration = SWARM_CONFIG.test_duration
  var vus_per_scenario = SWARM_CONFIG.vus_per_scenario
  var influxdb_port = COORDINATOR_CONFIG.influxdb_port
  var influxdb_database = COORDINATOR_CONFIG.influxdb_database

  sed -e "s|@@TARGET_URL@@|$target_url|g" \
      -e "s|@@TEST_DURATION@@|$test_duration|g" \
      -e "s|@@VUS_PER_SCENARIO@@|$vus_per_scenario|g" \
      -e "s|@@COORDINATOR_IP@@|$coordinator_ip|g" \
      -e "s|@@INFLUXDB_PORT@@|$influxdb_port|g" \
      -e "s|@@INFLUXDB_DATABASE@@|$influxdb_database|g" \
      -e "s|@@WORKER_ID@@|$worker_id|g" \
      "$template" > "$tmp_file"

  setglobal SWARM_STARTUP_SCRIPT_PATH = "$tmp_file"
}

# -----------------------------------------------------------------------------
# Instance Creation
# -----------------------------------------------------------------------------

proc create_swarm_instance (zone, instance_number, target_url, coordinator_ip) {
  # Create a single load generator instance in the specified zone
  var prefix = SWARM_CONFIG.instance_prefix
  var instance_name = "${prefix}-${instance_number}"
  var worker_id = "worker-${instance_number}"

  log "Creating instance $instance_name in $zone..."

  # Check if already exists
  check_instance_exists "$instance_name" "$zone"
  if (INSTANCE_EXISTS) {
    log "Instance $instance_name already exists in $zone"
    return 0
  }

  prepare_swarm_startup_script "$target_url" "$coordinator_ip" "$worker_id"
  trap "rm -f $SWARM_STARTUP_SCRIPT_PATH" EXIT

  gcloud compute instances create "$instance_name" \
    --project=$[CONFIG.project] \
    --zone="$zone" \
    --machine-type=$[SWARM_CONFIG.machine_type] \
    --image-family=ubuntu-2404-lts-amd64 \
    --image-project=ubuntu-os-cloud \
    --boot-disk-size=$[SWARM_CONFIG.boot_disk_size] \
    --metadata-from-file=startup-script="$SWARM_STARTUP_SCRIPT_PATH" \
    --scopes=compute-ro,storage-ro

  log "Instance $instance_name created"
}

proc provision_swarm (target_url, coordinator_ip) {
  # Provision the full load test swarm across all configured zones
  log_section "Provisioning Load Test Swarm"

  log "Target URL:     $target_url"
  log "Coordinator:    $coordinator_ip"
  log "Zones:          $[SWARM_CONFIG.zones => join(', ')]"
  log "Machine:        $[SWARM_CONFIG.machine_type]"
  log "Per zone:       $[SWARM_CONFIG.instances_per_zone]"
  log ""

  # Ensure project is ready
  ensure_project_ready

  var instance_number = 0

  for zone in @[SWARM_CONFIG.zones] {
    var zone_count = 0
    while (zone_count < SWARM_CONFIG.instances_per_zone) {
      create_swarm_instance "$zone" "$instance_number" "$target_url" "$coordinator_ip"
      setvar instance_number = instance_number + 1
      setvar zone_count = zone_count + 1
    }
  }

  log ""
  log_section "Swarm Provisioned"

  # Wait for instances to be ready
  wait_for_swarm_ready
}

proc check_single_instance_ready (instance) {
  # Check if a single instance has k6 installed
  # Sets: INSTANCE_READY global, INSTANCE_STATUS global

  # Find the zone for this instance
  var zone = $(gcloud compute instances list \
    --project=$[CONFIG.project] \
    --filter="name=$instance" \
    --format='value(zone)' 2>/dev/null | head -1)

  if test -z "$zone" {
    setglobal INSTANCE_READY = false
    setglobal INSTANCE_STATUS = "zone not found"
    return
  }

  # Check if k6 is installed via SSH
  var k6_path = ''
  var startup_active = ''

  try {
    setvar k6_path = $(gcloud compute ssh "$instance" \
      --project=$[CONFIG.project] \
      --zone="$zone" \
      --command="which k6 2>/dev/null || echo ''" \
      --ssh-flag="-o ConnectTimeout=10" \
      --ssh-flag="-o StrictHostKeyChecking=no" \
      2>/dev/null)
  }

  try {
    setvar startup_active = $(gcloud compute ssh "$instance" \
      --project=$[CONFIG.project] \
      --zone="$zone" \
      --command="systemctl is-active google-startup-scripts 2>/dev/null || echo 'inactive'" \
      --ssh-flag="-o ConnectTimeout=5" \
      --ssh-flag="-o StrictHostKeyChecking=no" \
      2>/dev/null)
  }

  if (k6_path ~~ '*/k6*') {
    setglobal INSTANCE_READY = true
    setglobal INSTANCE_STATUS = "✓ k6 ready ($zone)"
  } elif test "$startup_active" = "active" {
    setglobal INSTANCE_READY = false
    setglobal INSTANCE_STATUS = "⏳ startup running ($zone)"
  } elif test -n "$k6_path" {
    setglobal INSTANCE_READY = false
    setglobal INSTANCE_STATUS = "⏳ waiting for k6 ($zone)"
  } else {
    setglobal INSTANCE_READY = false
    setglobal INSTANCE_STATUS = "⏳ SSH not ready ($zone)"
  }
}

proc wait_for_swarm_ready {
  # Wait for all swarm instances to have k6 installed
  log "Waiting for swarm instances to be ready..."

  var max_attempts = 20
  var interval = 15
  var attempt = 1

  while (attempt <= max_attempts) {
    log ""
    log "━━━ Swarm status check $attempt/$max_attempts ━━━"

    # Get fresh list of instances
    get_swarm_instances

    if test -z "$SWARM_INSTANCES" {
      log "No swarm instances found"
      return 1
    }

    var all_ready = true
    var ready_count = 0
    var total_count = 0

    # Write instances to temp file and read back (avoid subshell scope issues)
    var tmp_file = $(mktemp)
    echo "$SWARM_INSTANCES" > $tmp_file

    # Process each instance
    while read instance {
      if test -z "$instance" {
        continue
      }
      setvar total_count = total_count + 1

      check_single_instance_ready "$instance"
      log "  $instance: $INSTANCE_STATUS"

      if (INSTANCE_READY) {
        setvar ready_count = ready_count + 1
      } else {
        setvar all_ready = false
      }
    } < $tmp_file

    rm -f $tmp_file

    log ""
    log "Ready: $ready_count/$total_count instances"

    if test "$all_ready" = true && test "$ready_count" -gt 0 {
      log ""
      log "✅ All swarm instances are ready!"
      return 0
    }

    log "Waiting ${interval}s..."
    sleep $interval
    setvar attempt = attempt + 1
  }

  log "WARNING: Some instances may not be fully ready after $max_attempts attempts"
  return 1
}

proc list_swarm {
  # List all swarm instances with their status
  log_section "Load Test Swarm Status"

  get_swarm_instances

  if test -z "$SWARM_INSTANCES" {
    log "No swarm instances found"
    return 0
  }

  log ""
  gcloud compute instances list \
    --project=$[CONFIG.project] \
    --filter="name~'^$[SWARM_CONFIG.instance_prefix]-'" \
    --format='table(name,zone,status,networkInterfaces[0].accessConfigs[0].natIP)'
}

proc get_swarm_ips {
  # Get external IPs of all swarm instances
  # Returns: sets SWARM_IPS as a List

  get_swarm_instances

  var ips = []
  for instance in $SWARM_INSTANCES {
    var ip = $(gcloud compute instances list \
      --project=$[CONFIG.project] \
      --filter="name=$instance" \
      --format='value(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null)

    if test -n "$ip" {
      call ips->append(ip)
    }
  }

  setglobal SWARM_IPS = ips
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc swarm_provision_main {
  require_commands gcloud

  var command = ${1:-list}

  case $command in
    create)
      var target = ${2:-}
      var coordinator = ${3:-}
      if test -z "$target" || test -z "$coordinator" {
        echo "Usage: provision-swarm.ysh create <target_url> <coordinator_ip>"
        echo "Example: provision-swarm.ysh create https://xxx.cloudfront.net 1.2.3.4"
        exit 1
      }
      provision_swarm "$target" "$coordinator"
      ;;
    list)
      list_swarm
      ;;
    ips)
      get_swarm_ips
      for ip in @SWARM_IPS {
        echo $ip
      }
      ;;
    wait)
      wait_for_swarm_ready
      ;;
    *)
      echo "Usage: provision-swarm.ysh <command> [args]"
      echo ""
      echo "Commands:"
      echo "  create <target_url> <coordinator_ip>  Create swarm"
      echo "  list                                  List all swarm instances"
      echo "  ips                                   Get external IPs of all instances"
      echo "  wait                                  Wait for all instances to be ready"
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------

if is-main {
  swarm_provision_main @ARGV
}
