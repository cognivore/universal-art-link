#!/usr/bin/env ysh
# =============================================================================
# Load Test Coordinator VM Provisioning
# Runs Grafana + InfluxDB for metrics aggregation (NO compilation)
# Includes DNS setup and TLS via Caddy
# =============================================================================

source-guard swarm/coordinator.ysh || return 0

source $_this_dir/../lib/config.ysh

# -----------------------------------------------------------------------------
# Coordinator Instance Management
# -----------------------------------------------------------------------------

proc check_coordinator_exists {
  # Check if coordinator instance exists
  # Sets: COORDINATOR_EXISTS global (true/false)
  var exists = ''
  try {
    setvar exists = $(gcloud compute instances describe $[COORDINATOR_CONFIG.instance_name] \
      --project=$[CONFIG.project] \
      --zone=$[COORDINATOR_CONFIG.zone] \
      --format='value(name)' 2>/dev/null)
  }

  if test -n "$exists" {
    setglobal COORDINATOR_EXISTS = true
  } else {
    setglobal COORDINATOR_EXISTS = false
  }
}

proc check_coordinator_healthy {
  # Check if coordinator services are running
  # Sets: COORDINATOR_HEALTHY global (true/false)
  # Requires: COORDINATOR_IP to be set

  if test -z "$COORDINATOR_IP" {
    setglobal COORDINATOR_HEALTHY = false
    return
  }

  var grafana_port = COORDINATOR_CONFIG.grafana_port
  var influxdb_port = COORDINATOR_CONFIG.influxdb_port

  var grafana_ok = ''
  var influx_ok = ''

  try {
    setvar grafana_ok = $(curl -s -o /dev/null -w '%{http_code}' \
      --connect-timeout 5 \
      "http://$COORDINATOR_IP:$grafana_port/api/health" 2>/dev/null)
  }

  try {
    setvar influx_ok = $(curl -s -o /dev/null -w '%{http_code}' \
      --connect-timeout 5 \
      "http://$COORDINATOR_IP:$influxdb_port/ping" 2>/dev/null)
  }

  if test "$grafana_ok" = "200" && test "$influx_ok" = "204" {
    setglobal COORDINATOR_HEALTHY = true
  } else {
    setglobal COORDINATOR_HEALTHY = false
    log "  Health check: Grafana=$grafana_ok, InfluxDB=$influx_ok"
  }
}

proc repair_coordinator {
  # Repair coordinator by re-running setup commands via SSH
  # Used when coordinator exists but services aren't healthy
  log "Attempting to repair coordinator services..."

  get_coordinator_ip

  var instance = COORDINATOR_CONFIG.instance_name
  var project = CONFIG.project
  var zone = COORDINATOR_CONFIG.zone

  # Check if Grafana is installed
  var grafana_installed = ''
  try {
    setvar grafana_installed = $(gcloud compute ssh $instance \
      --project=$project --zone=$zone \
      --command="dpkg -l | grep grafana || echo ''" 2>/dev/null)
  }

  if test -z "$grafana_installed" {
    log "Grafana not installed, installing via SSH..."

    # Install Grafana
    gcloud compute ssh $instance --project=$project --zone=$zone --command="
      set -e
      export DEBIAN_FRONTEND=noninteractive

      # Remove conflicting InfluxDB repo config if exists
      sudo rm -f /etc/apt/sources.list.d/influxdata.list 2>/dev/null || true

      # Add Grafana repository
      curl -s https://apt.grafana.com/gpg.key | sudo gpg --dearmor -o /usr/share/keyrings/grafana-archive-keyring.gpg
      echo 'deb [signed-by=/usr/share/keyrings/grafana-archive-keyring.gpg] https://apt.grafana.com stable main' | sudo tee /etc/apt/sources.list.d/grafana.list

      sudo apt-get update -y
      sudo apt-get install -y grafana

      # Configure Grafana
      sudo tee /etc/grafana/grafana.ini << 'EOF'
[server]
http_port = 3000
root_url = https://coordinator.melira.fere.me/grafana/
serve_from_sub_path = true

[security]
admin_user = admin
admin_password = admin

[auth.anonymous]
enabled = true
org_role = Viewer
EOF

      sudo systemctl enable grafana-server
      sudo systemctl start grafana-server
      echo 'Grafana installed and started'
    " 2>&1

    log "Grafana installation complete"
  }

  # Ensure services are running
  gcloud compute ssh $instance --project=$project --zone=$zone --command="
    sudo systemctl start influxdb || true
    sudo systemctl start grafana-server || true
    sudo systemctl start caddy || true
  " 2>/dev/null

  log "Repair complete, verifying health..."
  sleep 5
  check_coordinator_healthy
}

proc get_coordinator_ip {
  # Get external IP of coordinator
  # Returns: sets COORDINATOR_IP global

  var ip = ''
  try {
    setvar ip = $(gcloud compute instances describe $[COORDINATOR_CONFIG.instance_name] \
      --project=$[CONFIG.project] \
      --zone=$[COORDINATOR_CONFIG.zone] \
      --format='get(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null)
  }

  setglobal COORDINATOR_IP = "$ip"
}

# -----------------------------------------------------------------------------
# DNS Management for Coordinator
# -----------------------------------------------------------------------------

proc coordinator_dns_create {
  # Create DNS record for coordinator (idempotent)
  log "Ensuring DNS record for coordinator..."

  get_coordinator_ip

  if test -z "$COORDINATOR_IP" {
    log "ERROR: Coordinator IP not available"
    return 1
  }

  var fqdn = "$[COORDINATOR_CONFIG.domain]"

  # First check if DNS already points to the desired IP
  var current_ip = ''
  try {
    setvar current_ip = $(dig +short "$fqdn" '@8.8.8.8' 2>/dev/null | head -1)
  }

  if test "$current_ip" = "$COORDINATOR_IP" {
    log "DNS already points to $COORDINATOR_IP - no change needed"
    return 0
  }

  log "Current DNS: ${current_ip:-<none>}, desired: $COORDINATOR_IP"

  # We need to change DNS
  get_porkbun_secrets

  var api_url = "$[CONFIG.porkbun_api_base]/dns/create/$[CONFIG.pkb_domain]"

  var request_body = {
    apikey: PKB_API_KEY,
    secretapikey: PKB_API_SECRET,
    name: COORDINATOR_CONFIG.pkb_subdomain,
    type: 'A',
    content: COORDINATOR_IP,
    ttl: '5',
  }

  log "Creating A record: $fqdn -> $COORDINATOR_IP"

  var response = $(curl -s -X POST "$api_url" \
    -H 'Content-Type: application/json' \
    -d "$(json write (request_body))")

  var status = $(echo "$response" | jq -r '.status')

  if test "$status" = "SUCCESS" {
    log "DNS record created successfully"
    return 0
  }

  # Record might exist - try update
  log "Create failed, attempting update..."
  coordinator_dns_update_inner

  # Verify update worked - give DNS time to propagate
  log "Waiting for DNS propagation..."
  var verify_ip = ''
  var max_checks = 6
  var check = 1

  while (check <= max_checks) {
    sleep 10
    try {
      setvar verify_ip = $(dig +short "$fqdn" '@8.8.8.8' 2>/dev/null | head -1)
    }

    if test "$verify_ip" = "$COORDINATOR_IP" {
      log "DNS verified: $fqdn -> $COORDINATOR_IP"
      return 0
    }

    log "  DNS check $check/$max_checks: got $verify_ip, want $COORDINATOR_IP"
    setvar check = check + 1
  }

  # Still wrong after waiting - but Porkbun said OK, so it's likely just propagation delay
  # Check Porkbun's own record directly
  var pkb_record = ''
  try {
    var retrieve_url = "$[CONFIG.porkbun_api_base]/dns/retrieveByNameType/$[CONFIG.pkb_domain]/A/$[COORDINATOR_CONFIG.pkb_subdomain]"
    var retrieve_body = {
      apikey: PKB_API_KEY,
      secretapikey: PKB_API_SECRET,
    }
    var pkb_response = $(curl -s -X POST "$retrieve_url" \
      -H 'Content-Type: application/json' \
      -d "$(json write (retrieve_body))")
    setvar pkb_record = $(echo "$pkb_response" | jq -r '.records[0].content // ""')
  }

  if test "$pkb_record" = "$COORDINATOR_IP" {
    log "Porkbun confirms record is correct ($pkb_record) - DNS will propagate"
    log "Continuing despite slow propagation..."
    return 0
  }

  # Porkbun doesn't have the right record - this is a real problem
  log "ERROR: Failed to update DNS record"
  log "  Porkbun record: ${pkb_record:-none}, needed: $COORDINATOR_IP"
  log "  Please check Porkbun API status and credentials."
  exit 1
}

proc coordinator_dns_update_inner {
  # Internal helper - update DNS via edit endpoint (no pre-check)
  get_porkbun_secrets

  # First retrieve existing record to get ID
  var retrieve_url = "$[CONFIG.porkbun_api_base]/dns/retrieveByNameType/$[CONFIG.pkb_domain]/A/$[COORDINATOR_CONFIG.pkb_subdomain]"

  var retrieve_body = {
    apikey: PKB_API_KEY,
    secretapikey: PKB_API_SECRET,
  }

  var records = $(curl -s -X POST "$retrieve_url" \
    -H 'Content-Type: application/json' \
    -d "$(json write (retrieve_body))")

  var record_id = $(echo "$records" | jq -r '.records[0].id // ""')

  if test -z "$record_id" {
    log "No existing record found to update"
    return 1
  }

  # Update the record
  var update_url = "$[CONFIG.porkbun_api_base]/dns/edit/$[CONFIG.pkb_domain]/$record_id"

  var update_body = {
    apikey: PKB_API_KEY,
    secretapikey: PKB_API_SECRET,
    name: COORDINATOR_CONFIG.pkb_subdomain,
    type: 'A',
    content: COORDINATOR_IP,
    ttl: '5',
  }

  var response = $(curl -s -X POST "$update_url" \
    -H 'Content-Type: application/json' \
    -d "$(json write (update_body))")

  log "DNS record updated: $[COORDINATOR_CONFIG.domain] -> $COORDINATOR_IP"
}

proc coordinator_dns_delete {
  # Delete DNS record for coordinator
  log "Deleting DNS record for coordinator..."

  get_porkbun_secrets

  # Retrieve record ID
  var retrieve_url = "$[CONFIG.porkbun_api_base]/dns/retrieveByNameType/$[CONFIG.pkb_domain]/A/$[COORDINATOR_CONFIG.pkb_subdomain]"

  var retrieve_body = {
    apikey: PKB_API_KEY,
    secretapikey: PKB_API_SECRET,
  }

  var records = $(curl -s -X POST "$retrieve_url" \
    -H 'Content-Type: application/json' \
    -d "$(json write (retrieve_body))")

  var record_id = $(echo "$records" | jq -r '.records[0].id // ""')

  if test -z "$record_id" {
    log "No DNS record found for coordinator"
    return 0
  }

  # Delete the record
  var delete_url = "$[CONFIG.porkbun_api_base]/dns/delete/$[CONFIG.pkb_domain]/$record_id"

  var delete_body = {
    apikey: PKB_API_KEY,
    secretapikey: PKB_API_SECRET,
  }

  var response = $(curl -s -X POST "$delete_url" \
    -H 'Content-Type: application/json' \
    -d "$(json write (delete_body))")

  log "DNS record deleted for $[COORDINATOR_CONFIG.domain]"
}

# -----------------------------------------------------------------------------
# Startup Script Preparation
# -----------------------------------------------------------------------------

proc prepare_coordinator_startup_script {
  # Prepare the startup script for coordinator VM
  # Use path relative to this file, not $0 (which changes when sourced)
  var template = "$_this_dir/swarm/coordinator-startup.sh"

  if ! test -f "$template" {
    log "ERROR: Coordinator startup script not found at $template"
    exit 1
  }

  var tmp_file = $(mktemp)

  # Substitute configuration values
  sed -e "s|@@GRAFANA_PORT@@|$[COORDINATOR_CONFIG.grafana_port]|g" \
      -e "s|@@INFLUXDB_PORT@@|$[COORDINATOR_CONFIG.influxdb_port]|g" \
      -e "s|@@RECEIVER_PORT@@|$[COORDINATOR_CONFIG.receiver_port]|g" \
      -e "s|@@INFLUXDB_DATABASE@@|$[COORDINATOR_CONFIG.influxdb_database]|g" \
      -e "s|@@COORDINATOR_DOMAIN@@|$[COORDINATOR_CONFIG.domain]|g" \
      "$template" > "$tmp_file"

  setglobal COORDINATOR_STARTUP_SCRIPT_PATH = "$tmp_file"
}

# -----------------------------------------------------------------------------
# Instance Creation
# -----------------------------------------------------------------------------

proc create_coordinator {
  log_section "Creating Coordinator Instance"

  log "Instance: $[COORDINATOR_CONFIG.instance_name]"
  log "Zone:     $[COORDINATOR_CONFIG.zone]"
  log "Machine:  $[COORDINATOR_CONFIG.machine_type]"
  log "Domain:   $[COORDINATOR_CONFIG.domain]"

  # Check if already exists
  check_coordinator_exists
  if (COORDINATOR_EXISTS) {
    log "Coordinator instance already exists"
    get_coordinator_ip
    log "Coordinator IP: $COORDINATOR_IP"

    # Check if services are healthy
    log "Checking coordinator health..."
    check_coordinator_healthy
    if (COORDINATOR_HEALTHY) {
      log "Coordinator is healthy, skipping recreation"
      return 0
    } else {
      log "Coordinator exists but is unhealthy, attempting repair..."
      repair_coordinator
      if (COORDINATOR_HEALTHY) {
        log "Coordinator repaired successfully"
        return 0
      } else {
        log "WARNING: Coordinator repair may not be complete, continuing anyway"
        return 0
      }
    }
  }

  prepare_coordinator_startup_script
  trap "rm -f $COORDINATOR_STARTUP_SCRIPT_PATH" EXIT

  # Create firewall rule for coordinator ports (idempotent)
  # Include HTTP/HTTPS for Caddy TLS
  try {
    gcloud compute firewall-rules create allow-coordinator-ports \
      --project=$[CONFIG.project] \
      --allow=tcp:80,tcp:443,tcp:$[COORDINATOR_CONFIG.grafana_port],tcp:$[COORDINATOR_CONFIG.influxdb_port],tcp:$[COORDINATOR_CONFIG.receiver_port] \
      --target-tags=coordinator \
      --description="Allow HTTP, HTTPS, Grafana, InfluxDB, and metrics receiver" \
      2>/dev/null
  }

  log "Creating coordinator VM..."

  gcloud compute instances create $[COORDINATOR_CONFIG.instance_name] \
    --project=$[CONFIG.project] \
    --zone=$[COORDINATOR_CONFIG.zone] \
    --machine-type=$[COORDINATOR_CONFIG.machine_type] \
    --image-family=ubuntu-2404-lts-amd64 \
    --image-project=ubuntu-os-cloud \
    --boot-disk-size=$[COORDINATOR_CONFIG.boot_disk_size] \
    --tags=coordinator,http-server,https-server \
    --metadata-from-file=startup-script=$COORDINATOR_STARTUP_SCRIPT_PATH

  log "Coordinator instance created"

  # Get external IP
  get_coordinator_ip
  log "Coordinator IP: $COORDINATOR_IP"
}

proc check_startup_script_status {
  # Check startup script progress via SSH (non-blocking, best-effort)
  var instance = COORDINATOR_CONFIG.instance_name
  var project = CONFIG.project
  var zone = COORDINATOR_CONFIG.zone

  var startup_status = ''
  var last_log = ''

  try {
    setvar startup_status = $(gcloud compute ssh "$instance" \
      --project="$project" \
      --zone="$zone" \
      --ssh-flag="-o ConnectTimeout=5" \
      --ssh-flag="-o StrictHostKeyChecking=no" \
      --command="systemctl is-active google-startup-scripts 2>/dev/null || echo 'done'" \
      2>/dev/null)
  }

  try {
    setvar last_log = $(gcloud compute ssh "$instance" \
      --project="$project" \
      --zone="$zone" \
      --ssh-flag="-o ConnectTimeout=5" \
      --ssh-flag="-o StrictHostKeyChecking=no" \
      --command="sudo journalctl -u google-startup-scripts --no-pager -n 3 2>/dev/null | tail -1 | cut -c1-80" \
      2>/dev/null)
  }

  if test -n "$startup_status" {
    log "  Startup script: $startup_status"
  }
  if test -n "$last_log" {
    log "  Last log: $last_log"
  }
}

proc wait_for_coordinator_ready {
  # Wait for coordinator services to be available (HTTP first, then dashboards)
  log "Waiting for coordinator services to start..."

  get_coordinator_ip

  if test -z "$COORDINATOR_IP" {
    log "ERROR: Could not get coordinator IP"
    return 1
  }

  var grafana_port = COORDINATOR_CONFIG.grafana_port
  var influxdb_port = COORDINATOR_CONFIG.influxdb_port
  var max_attempts = 60
  var interval = 10
  var attempt = 1

  # Common vars for SSH commands (declared once, used in multiple if blocks)
  var instance = COORDINATOR_CONFIG.instance_name
  var project = CONFIG.project
  var zone = COORDINATOR_CONFIG.zone

  var grafana_url = "http://$COORDINATOR_IP:$grafana_port/api/health"
  var influx_url = "http://$COORDINATOR_IP:$influxdb_port/ping"

  # Phase 1: Wait for HTTP services to be ready
  log "Phase 1: Waiting for HTTP services..."
  log "  Grafana endpoint: $grafana_url"
  log "  InfluxDB endpoint: $influx_url"
  log ""

  while (attempt <= max_attempts) {
    log "Checking coordinator status (attempt $attempt/$max_attempts)..."

    # Check if Grafana is responding (via Caddy proxy or direct)
    var grafana_ok = ''
    var grafana_err = ''
    try {
      setvar grafana_ok = $(curl -s -o /dev/null -w '%{http_code}' \
        --connect-timeout 5 \
        "$grafana_url" 2>&1)
    }
    if test -z "$grafana_ok" {
      setvar grafana_ok = "timeout/unreachable"
    }

    # Check if InfluxDB is responding
    var influx_ok = ''
    try {
      setvar influx_ok = $(curl -s -o /dev/null -w '%{http_code}' \
        --connect-timeout 5 \
        "$influx_url" 2>&1)
    }
    if test -z "$influx_ok" {
      setvar influx_ok = "timeout/unreachable"
    }

    if test "$grafana_ok" = "200" && test "$influx_ok" = "204" {
      log ""
      log "HTTP services are ready!"
      break
    }

    log "  Grafana: $grafana_ok, InfluxDB: $influx_ok"

    # Every 3rd attempt, check startup script and service status
    if (attempt % 3 === 0) {
      check_startup_script_status

      # Also check systemd service status (using instance/project/zone from proc scope)
      var svc_status = ''
      try {
        setvar svc_status = $(gcloud compute ssh "$instance" \
          --project="$project" \
          --zone="$zone" \
          --ssh-flag="-o ConnectTimeout=5" \
          --ssh-flag="-o StrictHostKeyChecking=no" \
          --command="echo 'influxdb:' \$(systemctl is-active influxdb 2>/dev/null || echo 'not-found') 'grafana:' \$(systemctl is-active grafana-server 2>/dev/null || echo 'not-found') 'caddy:' \$(systemctl is-active caddy 2>/dev/null || echo 'not-found')" \
          2>/dev/null)
      }
      if test -n "$svc_status" {
        log "  Services: $svc_status"
      }
    }

    sleep $interval
    setvar attempt = attempt + 1
  }

  if (attempt > max_attempts) {
    log "WARNING: HTTP services not ready after $max_attempts attempts"
    return 1
  }

  # Phase 2: Verify Grafana dashboards are loaded
  log ""
  log "Phase 2: Verifying Grafana dashboards..."
  var dashboard_attempts = 12
  var dashboard_attempt = 1
  var expected_dashboards = 3  # k6, iocaine, systime

  while (dashboard_attempt <= dashboard_attempts) {
    var dashboard_count = ''
    try {
      setvar dashboard_count = $(curl -s \
        --connect-timeout 5 \
        "http://$COORDINATOR_IP:$grafana_port/api/search?type=dash-db" 2>/dev/null | jq 'length')
    }

    if test -n "$dashboard_count" && test "$dashboard_count" -ge "$expected_dashboards" {
      log "✅ Grafana has $dashboard_count dashboards loaded (expected >= $expected_dashboards)"
      break
    }

    log "  Dashboard check $dashboard_attempt/$dashboard_attempts: found ${dashboard_count:-0} dashboards"
    sleep 10
    setvar dashboard_attempt = dashboard_attempt + 1
  }

  # Phase 3: Wait for HTTPS/TLS to be ready (Caddy needs time to get certificate)
  log ""
  log "Phase 3: Waiting for HTTPS/TLS to be ready..."
  var https_url = "https://$[COORDINATOR_CONFIG.domain]/grafana/api/health"
  var tls_attempts = 20
  var tls_attempt = 1

  log "  HTTPS endpoint: $https_url"
  log "  Domain: $[COORDINATOR_CONFIG.domain]"

  # Check DNS resolution first
  var dns_ip = ''
  try {
    setvar dns_ip = $(dig +short "$[COORDINATOR_CONFIG.domain]" '@8.8.8.8' 2>/dev/null | head -1)
  }
  log "  DNS resolves to: ${dns_ip:-<not resolving>}"
  if test -n "$dns_ip" && test "$dns_ip" != "$COORDINATOR_IP" {
    log "  ⚠️  DNS mismatch! Expected $COORDINATOR_IP"
  }
  log ""

  while (tls_attempt <= tls_attempts) {
    var https_code = ''
    var curl_err = ''
    try {
      setvar https_code = $(curl -s -o /dev/null -w '%{http_code}' \
        --connect-timeout 5 --max-time 10 \
        "$https_url" 2>&1)
    }
    if test -z "$https_code" {
      setvar https_code = "timeout/unreachable"
    }

    if test "$https_code" = "200" {
      log ""
      log "✅ HTTPS ready: $https_url"
      log ""
      log "Coordinator fully operational!"
      return 0
    }

    log "  HTTPS check $tls_attempt/$tls_attempts: $https_code"

    # Every 3rd attempt, check Caddy status and logs
    if (tls_attempt % 3 === 0) {
      # Reuse instance/project/zone from earlier in the proc
      var caddy_status = ''
      var caddy_log = ''
      try {
        setvar caddy_status = $(gcloud compute ssh "$instance" \
          --project="$project" \
          --zone="$zone" \
          --ssh-flag="-o ConnectTimeout=5" \
          --ssh-flag="-o StrictHostKeyChecking=no" \
          --command="systemctl is-active caddy 2>/dev/null || echo 'not-running'" \
          2>/dev/null)
      }
      try {
        setvar caddy_log = $(gcloud compute ssh "$instance" \
          --project="$project" \
          --zone="$zone" \
          --ssh-flag="-o ConnectTimeout=5" \
          --ssh-flag="-o StrictHostKeyChecking=no" \
          --command="sudo journalctl -u caddy --no-pager -n 2 2>/dev/null | tail -1 | cut -c1-100" \
          2>/dev/null)
      }
      if test -n "$caddy_status" {
        log "  Caddy service: $caddy_status"
      }
      if test -n "$caddy_log" {
        log "  Caddy log: $caddy_log"
      }

      # Re-check DNS in case it propagated
      try {
        setvar dns_ip = $(dig +short "$[COORDINATOR_CONFIG.domain]" '@8.8.8.8' 2>/dev/null | head -1)
      }
      log "  DNS: ${dns_ip:-<not resolving>} (need: $COORDINATOR_IP)"
    }

    sleep 15
    setvar tls_attempt = tls_attempt + 1
  }

  log ""
  log "WARNING: HTTPS may not be ready yet (DNS propagation or TLS cert issue)"
  log "HTTP services are working - you can access via: http://$COORDINATOR_IP:$grafana_port"
  return 0
}

proc provision_coordinator {
  # Full coordinator provisioning workflow
  log_section "Provisioning Load Test Coordinator"

  # Ensure project is ready
  ensure_project_ready

  # Create coordinator instance
  create_coordinator

  # Create DNS record
  coordinator_dns_create

  # Wait for services
  wait_for_coordinator_ready

  log_section "Coordinator Ready"
  log ""
  log "Domain:           https://$[COORDINATOR_CONFIG.domain]"
  log ""
  log "Grafana Dashboard: https://$[COORDINATOR_CONFIG.domain]/grafana"
  log "  Or direct:       http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.grafana_port]"
  log "  Default login:   admin / admin"
  log ""
  log "InfluxDB:          http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.influxdb_port]"
  log ""
}

# -----------------------------------------------------------------------------
# Coordinator Deletion
# -----------------------------------------------------------------------------

proc delete_coordinator {
  log_section "Deleting Coordinator Instance"

  # Delete DNS record first
  try {
    coordinator_dns_delete
  }

  check_coordinator_exists
  if (not COORDINATOR_EXISTS) {
    log "Coordinator instance does not exist"
    return 0
  }

  log "Deleting: $[COORDINATOR_CONFIG.instance_name]"

  gcloud compute instances delete $[COORDINATOR_CONFIG.instance_name] \
    --project=$[CONFIG.project] \
    --zone=$[COORDINATOR_CONFIG.zone] \
    --quiet

  log "Coordinator deleted"
}

proc coordinator_status {
  # Show coordinator status
  log_section "Coordinator Status"

  check_coordinator_exists
  if (not COORDINATOR_EXISTS) {
    log "Coordinator instance does not exist"
    return 1
  }

  get_coordinator_ip

  var status = $(gcloud compute instances describe $[COORDINATOR_CONFIG.instance_name] \
    --project=$[CONFIG.project] \
    --zone=$[COORDINATOR_CONFIG.zone] \
    --format='value(status)' 2>/dev/null)

  log "Instance: $[COORDINATOR_CONFIG.instance_name]"
  log "Status:   $status"
  log "IP:       $COORDINATOR_IP"
  log "Domain:   $[COORDINATOR_CONFIG.domain]"
  log ""
  log "Services:"
  log "  Grafana:  https://$[COORDINATOR_CONFIG.domain]/grafana"
  log "            http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.grafana_port]"
  log "  InfluxDB: http://$COORDINATOR_IP:$[COORDINATOR_CONFIG.influxdb_port]"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc coordinator_main {
  require_commands gcloud curl

  var command = ${1:-status}

  case $command in
    create|provision)
      provision_coordinator
      ;;
    delete)
      delete_coordinator
      ;;
    status)
      coordinator_status
      ;;
    ip)
      get_coordinator_ip
      echo $COORDINATOR_IP
      ;;
    wait)
      wait_for_coordinator_ready
      ;;
    dns-create)
      get_coordinator_ip
      coordinator_dns_create
      ;;
    dns-delete)
      coordinator_dns_delete
      ;;
    *)
      echo "Usage: coordinator.ysh <command>"
      echo ""
      echo "Commands:"
      echo "  create      Create coordinator instance with DNS"
      echo "  delete      Delete coordinator instance and DNS"
      echo "  status      Show coordinator status"
      echo "  ip          Print coordinator IP"
      echo "  wait        Wait for services to be ready"
      echo "  dns-create  Create/update DNS record only"
      echo "  dns-delete  Delete DNS record only"
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------

if is-main {
  coordinator_main @ARGV
}
