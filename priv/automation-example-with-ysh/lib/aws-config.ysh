#!/usr/bin/env ysh
# =============================================================================
# AWS Configuration and Credentials Management
# Handles AWS CLI authentication via passveil secrets
# =============================================================================

source-guard lib/aws-config.ysh || return 0

source $_this_dir/config.ysh

# -----------------------------------------------------------------------------
# AWS Credentials from Passveil
# -----------------------------------------------------------------------------

proc get_aws_credentials {
  # Fetch AWS credentials from passveil
  # Format: line 1 = AWS_ACCESS_KEY_ID, line 2 = AWS_SECRET_ACCESS_KEY
  # Returns: sets AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY in environment

  log "Fetching AWS credentials from passveil..."

  var creds_path = AWS_CONFIG.passveil_path

  var all_creds = ''
  try {
    setvar all_creds = $(passveil show $creds_path 2>/dev/null)
  }

  if test -n "$all_creds" {
    # Credentials found: line 1 = access key, line 2 = secret key
    var key_id = $(echo "$all_creds" | head -1)
    var secret = $(echo "$all_creds" | tail -1)

    # Export for child processes (temporarily allow export builtin)
    shopt --unset ysh:all {
      export AWS_ACCESS_KEY_ID="$key_id"
      export AWS_SECRET_ACCESS_KEY="$secret"
    }
    log "AWS credentials loaded from passveil"
  } else {
    log "NOTE: No credentials found at $creds_path"
    log "Attempting to use existing AWS CLI configuration..."

    # Fall back to checking if AWS CLI is already configured
    if ! aws sts get-caller-identity > /dev/null 2>&1 {
      log "ERROR: AWS CLI not configured and no passveil credentials found"
      log "Please run 'aws configure' or add credentials to passveil"
      exit 1
    }
    log "Using existing AWS CLI configuration"
  }
}

proc ensure_aws_auth {
  # Ensure AWS CLI is authenticated and working
  log "Checking AWS authentication..."

  # Try to get caller identity
  var identity = ''
  try {
    setvar identity = $(aws sts get-caller-identity --output json 2>/dev/null)
  }

  if test -z "$identity" {
    # Not authenticated, try to load from passveil
    get_aws_credentials

    # Verify again
    try {
      setvar identity = $(aws sts get-caller-identity --output json 2>/dev/null)
    }

    if test -z "$identity" {
      log "ERROR: AWS authentication failed"
      exit 1
    }
  }

  var account = $(echo "$identity" | jq -r '.Account')
  var arn = $(echo "$identity" | jq -r '.Arn')

  log "AWS authenticated as: $arn"
  log "Account: $account"

  # Verify account matches config
  var expected_account = AWS_CONFIG.account_id
  if test "$account" != "$expected_account" {
    log "WARNING: Account mismatch! Expected $expected_account, got $account"
  }
}

# -----------------------------------------------------------------------------
# AWS Region Configuration
# -----------------------------------------------------------------------------

proc set_aws_region {
  # Set AWS region for CloudFront operations
  # CloudFront functions MUST be created in us-east-1
  var region = AWS_CONFIG.region

  # Export for child processes
  shopt --unset ysh:all {
    export AWS_DEFAULT_REGION="$region"
    export AWS_REGION="$region"
  }
  log "AWS region set to $region"
}

# -----------------------------------------------------------------------------
# CloudFront Helpers
# -----------------------------------------------------------------------------

proc get_cloudfront_distribution_id {
  # Find distribution by comment (our identifier)
  # Returns: sets CLOUDFRONT_DISTRIBUTION_ID in caller scope

  var comment = AWS_CONFIG.cloudfront.distribution_comment
  log "Looking for CloudFront distribution with comment: $comment"

  var dist_id = ''
  try {
    setvar dist_id = $(aws cloudfront list-distributions \
      --query "DistributionList.Items[?Comment=='$comment'].Id" \
      --output text 2>/dev/null)
  }

  if test -n "$dist_id" && test "$dist_id" != "None" {
    setglobal CLOUDFRONT_DISTRIBUTION_ID = "$dist_id"
    log "Found distribution: $dist_id"
  } else {
    setglobal CLOUDFRONT_DISTRIBUTION_ID = ""
    log "No existing distribution found"
  }
}

proc get_cloudfront_function_arn {
  # Get the ARN of the classifier function (LIVE stage only)
  # Returns: sets CLOUDFRONT_FUNCTION_ARN in caller scope

  var func_name = AWS_CONFIG.cloudfront.function_name
  log "Looking for CloudFront function: $func_name"

  var func_arn = ''
  try {
    # Filter for LIVE stage only to avoid duplicate ARNs
    setvar func_arn = $(aws cloudfront list-functions --stage LIVE \
      --query "FunctionList.Items[?Name=='$func_name'].FunctionMetadata.FunctionARN | [0]" \
      --output text 2>/dev/null)
  }

  if test -n "$func_arn" && test "$func_arn" != "None" && test "$func_arn" != "null" {
    setglobal CLOUDFRONT_FUNCTION_ARN = "$func_arn"
    log "Found function: $func_arn"
  } else {
    setglobal CLOUDFRONT_FUNCTION_ARN = ""
    log "No existing function found"
  }
}

proc wait_for_distribution_deployed (distribution_id; max_attempts=60, interval=30) {
  # Wait for CloudFront distribution to reach 'Deployed' status
  log "Waiting for distribution $distribution_id to deploy..."

  var attempt = 1

  while (attempt <= max_attempts) {
    var status = ''
    try {
      setvar status = $(aws cloudfront get-distribution \
        --id "$distribution_id" \
        --query 'Distribution.Status' \
        --output text 2>/dev/null)
    }

    if test "$status" = "Deployed" {
      log "Distribution deployed successfully!"
      return 0
    }

    log "Status: $status (attempt $attempt/$max_attempts, waiting ${interval}s...)"
    sleep $interval
    setvar attempt = attempt + 1
  }

  var timeout_mins = max_attempts * interval / 60
  log "WARNING: Distribution deploy timeout after $timeout_mins minutes"
  return 1
}
