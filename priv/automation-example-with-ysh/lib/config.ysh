  boot_disk_size: '30GB',

  # Billing account ID (from GCP Console)
  billing_account: '01E906-A607DF-19CDD0',
  organization_id: '929673943880',

  domain: 'chunky.melira.fere.me',
  pkb_domain: 'fere.me',
  pkb_subdomain: 'chunky.melira',

  iocaine_port: 42069,

  porkbun_api_base: 'https://api.porkbun.com/api/json/v3',

  repo_url: 'https://github.com/geosurge-ai/iocaine-classifier.git',
  repo_branch: 'main',

  dns_timeout_seconds: 600,
  dns_poll_interval: 10,
