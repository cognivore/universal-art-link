  # Batching config for workers
  batch_interval: 10,  # Workers push every 10 seconds
}

# -----------------------------------------------------------------------------
# Active Configuration (mutable copies of the base blueprints)
# Using setglobal so they can be updated by set_deployment_prefix
# -----------------------------------------------------------------------------

setglobal DEPLOYMENT_PREFIX = ''
setglobal CONFIG = BASE_CONFIG
setglobal AWS_CONFIG = BASE_AWS_CONFIG
setglobal SWARM_CONFIG = BASE_SWARM_CONFIG
setglobal SYSTIME_CONFIG = BASE_SYSTIME_CONFIG
setglobal COORDINATOR_CONFIG = BASE_COORDINATOR_CONFIG

# -----------------------------------------------------------------------------
# Deployment Prefix Helpers
# -----------------------------------------------------------------------------

proc sanitize_prefix (raw_prefix) {
  var lowered = $(echo "$raw_prefix" | tr '[:upper:]' '[:lower:]')
  var cleaned = $(echo "$lowered" | sed -e 's/[^a-z0-9-]/-/g' -e 's/--\+/-/g' -e 's/^-//' -e 's/-$//')

  if test -z "$cleaned" {
    echo ''
    return
  }

  var first_char = $(printf '%.1s' "$cleaned")
  case $first_char in
    ([a-z])
      echo "$cleaned"
      ;;
    (*)
      echo "p-$cleaned"
      ;;
  esac
}

proc build_prefixed_name (prefix, base_name) {
  if test -z "$prefix" {
    echo "$base_name"
    return
  }
  echo "$prefix-$base_name"
}

proc build_prefixed_domain (prefix, fqdn) {
  if test -z "$prefix" || test -z "$fqdn" {
    echo "$fqdn"
    return
  }

  # Check if fqdn contains a dot
  case $fqdn in
    (*.*)
      # Multi-segment: prefix the first segment
      var first = $(echo "$fqdn" | cut -d'.' -f1)
      var rest = $(echo "$fqdn" | cut -d'.' -f2-)
      echo "$prefix-$first.$rest"
      ;;
    (*)
      # Single segment: just prefix it
      echo "$prefix-$fqdn"
      ;;
  esac
}

proc set_deployment_prefix (raw_prefix) {
  var prefix = $(sanitize_prefix "$raw_prefix")
  setglobal DEPLOYMENT_PREFIX = "$prefix"

  if test -z "$prefix" {
    setglobal CONFIG = BASE_CONFIG
    setglobal AWS_CONFIG = BASE_AWS_CONFIG
    setglobal SWARM_CONFIG = BASE_SWARM_CONFIG
    setglobal SYSTIME_CONFIG = BASE_SYSTIME_CONFIG
    setglobal COORDINATOR_CONFIG = BASE_COORDINATOR_CONFIG
    return
  }

  # Build prefixed identifiers
  var pref_project = $(build_prefixed_name "$prefix" "$[BASE_CONFIG.project]")
  var pref_instance = $(build_prefixed_name "$prefix" "$[BASE_CONFIG.instance_name]")
  var pref_domain = $(build_prefixed_domain "$prefix" "$[BASE_CONFIG.domain]")
  var pref_pkb_subdomain = $(build_prefixed_domain "$prefix" "$[BASE_CONFIG.pkb_subdomain]")

  # Update CONFIG (json read creates local, so read into tmp then setglobal)
  var config_json = $(json write (BASE_CONFIG))
  var updated_config = $(jq \
    --arg project "$pref_project" \
    --arg instance_name "$pref_instance" \
    --arg domain "$pref_domain" \
    --arg pkb_subdomain "$pref_pkb_subdomain" \
    '.project=$project | .instance_name=$instance_name | .domain=$domain | .pkb_subdomain=$pkb_subdomain' \
    <<< "$config_json")
  var tmp_config
  json read (&tmp_config) <<< $updated_config
  setglobal CONFIG = tmp_config

  # Update AWS_CONFIG
  var pref_function = $(build_prefixed_name "$prefix" "$[BASE_AWS_CONFIG.cloudfront.function_name]")
  var pref_distribution = $(build_prefixed_name "$prefix" "$[BASE_AWS_CONFIG.cloudfront.distribution_comment]")
  var pref_cf_domain = $(build_prefixed_domain "$prefix" "$[BASE_AWS_CONFIG.cloudfront.domain]")
  var pref_cf_subdomain = $(build_prefixed_domain "$prefix" "$[BASE_AWS_CONFIG.cloudfront.pkb_subdomain]")
  var aws_json = $(json write (BASE_AWS_CONFIG))
  var updated_aws = $(jq \
    --arg function_name "$pref_function" \
    --arg distribution_comment "$pref_distribution" \
    --arg cf_domain "$pref_cf_domain" \
    --arg cf_subdomain "$pref_cf_subdomain" \
    '.cloudfront.function_name=$function_name | .cloudfront.distribution_comment=$distribution_comment | .cloudfront.domain=$cf_domain | .cloudfront.pkb_subdomain=$cf_subdomain' \
    <<< "$aws_json")
  var tmp_aws
  json read (&tmp_aws) <<< $updated_aws
  setglobal AWS_CONFIG = tmp_aws

  # Update SWARM_CONFIG
  var pref_swarm_prefix = $(build_prefixed_name "$prefix" "$[BASE_SWARM_CONFIG.instance_prefix]")
  var swarm_json = $(json write (BASE_SWARM_CONFIG))
  var updated_swarm = $(jq \
    --arg instance_prefix "$pref_swarm_prefix" \
    '.instance_prefix=$instance_prefix' \
    <<< "$swarm_json")
  var tmp_swarm
  json read (&tmp_swarm) <<< $updated_swarm
  setglobal SWARM_CONFIG = tmp_swarm

  # Update COORDINATOR_CONFIG
  var pref_coord_instance = $(build_prefixed_name "$prefix" "$[BASE_COORDINATOR_CONFIG.instance_name]")
  var pref_coord_domain = $(build_prefixed_domain "$prefix" "$[BASE_COORDINATOR_CONFIG.domain]")
  var pref_coord_subdomain = $(build_prefixed_domain "$prefix" "$[BASE_COORDINATOR_CONFIG.pkb_subdomain]")
  var coordinator_json = $(json write (BASE_COORDINATOR_CONFIG))
  var updated_coordinator = $(jq \
    --arg instance_name "$pref_coord_instance" \
    --arg domain "$pref_coord_domain" \
    --arg pkb_subdomain "$pref_coord_subdomain" \
    '.instance_name=$instance_name | .domain=$domain | .pkb_subdomain=$pkb_subdomain' \
    <<< "$coordinator_json")
  var tmp_coordinator
  json read (&tmp_coordinator) <<< $updated_coordinator
  setglobal COORDINATOR_CONFIG = tmp_coordinator

  # Update SYSTIME_CONFIG
  var pref_systime_instance = $(build_prefixed_name "$prefix" "$[BASE_SYSTIME_CONFIG.instance_name]")
  var pref_systime_domain = $(build_prefixed_domain "$prefix" "$[BASE_SYSTIME_CONFIG.domain]")
  var pref_systime_subdomain = $(build_prefixed_domain "$prefix" "$[BASE_SYSTIME_CONFIG.pkb_subdomain]")
  var systime_json = $(json write (BASE_SYSTIME_CONFIG))
  var updated_systime = $(jq \
    --arg instance_name "$pref_systime_instance" \
    --arg domain "$pref_systime_domain" \
    --arg pkb_subdomain "$pref_systime_subdomain" \
    '.instance_name=$instance_name | .domain=$domain | .pkb_subdomain=$pkb_subdomain' \
    <<< "$systime_json")
  var tmp_systime
  json read (&tmp_systime) <<< $updated_systime
  setglobal SYSTIME_CONFIG = tmp_systime
}

# -----------------------------------------------------------------------------
# Utility Functions (defined first - used by others)
# -----------------------------------------------------------------------------

proc log (msg) {
  echo "[$(date '+%H:%M:%S')] $msg"
}

proc log_section (title) {
  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════════"
  echo " $title"
  echo "═══════════════════════════════════════════════════════════════════════════════"
}

proc require_command (cmd) {
  if ! command -v $cmd > /dev/null 2>&1 {
    echo "ERROR: Required command '$cmd' not found." >&2
    exit 1
  }
}

proc require_commands {
  for cmd in @ARGV {
    require_command $cmd
  }
}

# -----------------------------------------------------------------------------
# Secrets from Passveil
# -----------------------------------------------------------------------------

proc get_porkbun_secrets {
  # Fetch API key and secret from passveil
  # Returns: sets PKB_API_KEY and PKB_API_SECRET in caller scope

  var creds = $(passveil show porkbun.com/api)
  setglobal PKB_API_KEY = $(echo $creds | head -1)
  setglobal PKB_API_SECRET = $(echo $creds | tail -1)
}

proc get_github_token {
  # Fetch GitHub token for cloning private repos
  # Returns: sets GITHUB_TOKEN in caller scope

  setglobal GITHUB_TOKEN = $(passveil show geosurge.ai/github.com/api/token/geomancer/meta-iocaine-ro | head -1)
}

# -----------------------------------------------------------------------------
# GCP Authentication & Project Setup
# -----------------------------------------------------------------------------

proc ensure_gcloud_auth {
  log "Checking gcloud authentication..."

  # Test if we can get an access token
  var test_result = ''
  try {
    setvar test_result = $(gcloud auth print-access-token 2>&1)
  }

  # Check if result is empty or looks like an error
  var needs_auth = false

  if test -z "$test_result" {
    setvar needs_auth = true
  }

  # Check if it starts with "ya29" (valid token) using cut
  if test "$needs_auth" = false {
    var prefix = $(echo "$test_result" | cut -c1-4)
    if test "$prefix" != "ya29" {
      setvar needs_auth = true
    }
  }

  if test "$needs_auth" = true {
    log ""
    log "⚠️  GCloud authentication required!"
    log ""
    log "Your gcloud credentials have expired or are invalid."
    log "Opening browser for authentication..."
    log ""

    # Launch auth interactively
    gcloud auth login

    # Check again after auth attempt
    try {
      setvar test_result = $(gcloud auth print-access-token 2>&1)
    }

    if test -z "$test_result" {
      log "ERROR: Authentication failed. Please run 'gcloud auth login' manually."
      exit 1
    }

    setvar prefix = $(echo "$test_result" | cut -c1-4)
    if test "$prefix" != "ya29" {
      log "ERROR: Authentication failed. Please run 'gcloud auth login' manually."
      exit 1
    }
  }

  log "Authentication valid"

  # Set default project to avoid any "stray" gcloud calls hitting wrong project
  log "Setting default project to $[CONFIG.project]..."
  gcloud config set project $[CONFIG.project] 2>/dev/null
}

# -----------------------------------------------------------------------------
# GCP Project & Billing Management
# -----------------------------------------------------------------------------

proc ensure_project_exists {
  # Create project if it doesn't exist (idempotent)
  log "Ensuring project $[CONFIG.project] exists..."

  var exists = ''
  try {
    setvar exists = $(gcloud projects describe $[CONFIG.project] --format='value(projectId)' 2>/dev/null)
  }

  if test -z "$exists" {
    log "Creating project $[CONFIG.project]..."
    gcloud projects create $[CONFIG.project] --organization=$[CONFIG.organization_id]

    # Verify it was created
    try {
      setvar exists = $(gcloud projects describe $[CONFIG.project] --format='value(projectId)' 2>/dev/null)
    }

    if test -z "$exists" {
      log "ERROR: Failed to create project $[CONFIG.project]"
      exit 1
    }
    log "Project created successfully"
  } else {
    log "Project $[CONFIG.project] already exists"
  }
}

proc check_billing_account_open {
  # Verify the billing account is open/active (not closed/suspended)
  log "Checking billing account $[CONFIG.billing_account] is open..."

  var is_open = ''
  try {
    setvar is_open = $(gcloud beta billing accounts describe $[CONFIG.billing_account] --format='value(open)' 2>/dev/null)
  }

  if test "$is_open" != "True" {
    log "ERROR: Billing account $[CONFIG.billing_account] is not open (status: $is_open)"
    log "Please check the billing account in the GCP Console."
    exit 1
  }

  log "Billing account is open and active"
}

proc ensure_billing_linked {
  # Link billing account to project if not already linked (idempotent)
  log "Checking billing status for project $[CONFIG.project]..."

  var billing_info = '{}'
  try {
    setvar billing_info = $(gcloud billing projects describe $[CONFIG.project] --format=json 2>/dev/null)
  }

  if test -z "$billing_info" {
    setvar billing_info = '{}'
  }

  var billing_enabled = $(echo $billing_info | jq -r '.billingEnabled // false')
  var current_account = $(echo $billing_info | jq -r '.billingAccountName // ""' | sed 's|billingAccounts/||')

  if test "$billing_enabled" = "true" && test "$current_account" = "$[CONFIG.billing_account]" {
    log "Billing already linked to account $[CONFIG.billing_account]"
  } else {
    if test "$billing_enabled" = "true" {
      log "Project has different billing account: $current_account"
    }
    log "Linking billing account $[CONFIG.billing_account]..."
    gcloud billing projects link $[CONFIG.project] --billing-account=$[CONFIG.billing_account]
    log "Billing account linked"
  }

  # Wait for billing to propagate (up to 60 seconds)
  log "Waiting for billing to propagate..."
  var attempt = 1
  var max_attempts = 12

  while (attempt <= max_attempts) {
    var enabled = ''
    try {
      setvar enabled = $(gcloud billing projects describe $[CONFIG.project] --format='value(billingEnabled)' 2>/dev/null)
    }

    if test "$enabled" = "True" {
      log "Billing is now enabled (confirmed)"
      return
    }

    log "Billing not fully propagated yet, retrying ($attempt/$max_attempts)..."
    sleep 5
    setvar attempt = attempt + 1
  }

  log "WARNING: Billing propagation check timed out. Proceeding anyway..."
}

proc ensure_apis_enabled {
  # Enable required APIs (idempotent - succeeds if already enabled)
  log "Enabling required APIs..."

  # Cloud Billing API - helps with billing state queries
  gcloud services enable cloudbilling.googleapis.com --project=$[CONFIG.project]
  log "Cloud Billing API enabled"

  # Compute Engine API - required for VM creation
  gcloud services enable compute.googleapis.com --project=$[CONFIG.project]
  log "Compute Engine API enabled"
}

# -----------------------------------------------------------------------------
# SSH and Instance Readiness
# -----------------------------------------------------------------------------

proc wait_for_ssh (instance, project, zone; max_attempts=30, interval=10) {
  # Wait for SSH to become available on a GCE instance
  # Uses try/catch for idiomatic YSH error handling
  log "Waiting for SSH to become available on $instance..."

  var attempt = 1

  while (attempt <= max_attempts) {
    log "SSH connection attempt $attempt/$max_attempts..."

    try {
      gcloud compute ssh $instance \
        --project=$project \
        --zone=$zone \
        --command="echo 'SSH ready'" \
        --ssh-flag="-o ConnectTimeout=10" \
        --ssh-flag="-o StrictHostKeyChecking=no" \
        2>/dev/null
      log "SSH connection established!"
      return 0
    }

    log "SSH not ready, retrying in $interval seconds..."
    sleep $interval
    setvar attempt = attempt + 1
  }

  log "ERROR: SSH connection failed after $max_attempts attempts"
  return 1
}

proc wait_for_startup_complete (instance, project, zone; max_attempts=90, interval=20) {
  # Wait for GCE startup script to complete
  # Shows detailed progress from the VM
  log "Waiting for startup script to complete (this may take 5-10 minutes for cargo build)..."

  var attempt = 1

  while (attempt <= max_attempts) {
    var elapsed_min = (attempt - 1) * interval / 60
    log ""
    log "━━━ Status check $attempt/$max_attempts (~${elapsed_min}m elapsed) ━━━"

    # Get detailed status from the VM
    var debug_output = ''
    try {
      setvar debug_output = $(gcloud compute ssh $instance \
        --project=$project \
        --zone=$zone \
        --ssh-flag="-o ConnectTimeout=10" \
        --ssh-flag="-o StrictHostKeyChecking=no" \
        --command='
          echo "=== Services ==="
          echo -n "iocaine: "; systemctl is-active iocaine 2>/dev/null || echo "not-found"
          echo -n "startup-scripts: "; systemctl is-active google-startup-scripts 2>/dev/null || echo "inactive"
          echo ""
          echo "=== Last 5 startup log lines ==="
          sudo grep -i "startup" /var/log/syslog 2>/dev/null | tail -5 || echo "(no logs yet)"
          echo ""
          echo "=== Disk usage ==="
          df -h / | tail -1
          echo ""
          echo "=== Memory ==="
          free -h | grep Mem
          echo ""
          echo "=== Running processes (cargo/nix) ==="
          ps aux | grep -E "(cargo|nix|rustc)" | grep -v grep | head -3 || echo "(none)"
        ' 2>/dev/null)
    }

    if test -n "$debug_output" {
      echo "$debug_output"
    }

    # Check if iocaine is running
    var iocaine_status = ''
    try {
      setvar iocaine_status = $(gcloud compute ssh $instance \
        --project=$project \
        --zone=$zone \
        --command="systemctl is-active iocaine 2>/dev/null || echo 'not-ready'" \
        --ssh-flag="-o ConnectTimeout=10" \
        --ssh-flag="-o StrictHostKeyChecking=no" \
        2>/dev/null)
    }

    if test "$iocaine_status" = "active" {
      log ""
      log "✅ Startup script complete - iocaine is running!"
      return 0
    }

    # Check if startup script has finished (success or failure)
    var startup_status = ''
    try {
      setvar startup_status = $(gcloud compute ssh $instance \
        --project=$project \
        --zone=$zone \
        --command="systemctl is-active google-startup-scripts 2>/dev/null || echo 'unknown'" \
        --ssh-flag="-o ConnectTimeout=10" \
        --ssh-flag="-o StrictHostKeyChecking=no" \
        2>/dev/null)
    }

    if test "$startup_status" = "inactive" {
      # Startup script finished but iocaine isn't running - check why
      log ""
      log "⚠️  Startup script finished but iocaine not active. Checking logs..."
      try {
        gcloud compute ssh $instance \
          --project=$project \
          --zone=$zone \
          --command='echo "=== Iocaine service logs ==="; sudo journalctl -u iocaine --no-pager -n 30 2>/dev/null || echo "No iocaine logs"; echo ""; echo "=== Startup script errors ==="; sudo grep -iE "error|fatal|failed" /var/log/syslog 2>/dev/null | tail -10 || echo "No errors found"' \
          --ssh-flag="-o StrictHostKeyChecking=no"
      }
      log ""
      log "Startup script completed (check logs above for errors)"
      return 0
    }

    log ""
    log "⏳ Startup in progress, next check in $interval seconds..."
    sleep $interval
    setvar attempt = attempt + 1
  }

  log ""
  log "⚠️  WARNING: Startup timeout after $[max_attempts * interval / 60] minutes"
  log "Proceeding anyway - check instance logs if issues persist"
  return 0
}

proc verify_billing_works {
  # Probe to verify billing is actually working before instance creation
  log "Verifying billing is functional..."

  var probe_result = ''
  try {
    setvar probe_result = $(gcloud compute project-info describe --project=$[CONFIG.project] --format='value(name)' 2>&1)
  }

  # Check if the probe failed with billing error (case-insensitive check without pipeline)
  var probe_lower = $(echo "$probe_result" | tr '[:upper:]' '[:lower:]')
  case $probe_lower in
    (*billing*)
      log "ERROR: Billing is not yet functional for Compute Engine"
      log "Output: $probe_result"
      log ""
      log "Please try one of:"
      log "  1. Wait a few more minutes and retry"
      log "  2. Visit: https://console.developers.google.com/billing/enable?project=$[CONFIG.project]"
      exit 1
      ;;
  esac

  log "Billing verified - Compute Engine is ready"
}

proc ensure_project_ready {
  # Ensure gcloud is authenticated first
  ensure_gcloud_auth

  # Verify billing account is open/active
  check_billing_account_open

  # Ensure project exists
  ensure_project_exists

  # Link billing with propagation wait
  ensure_billing_linked

  # Enable required APIs
  ensure_apis_enabled

  # Final verification that billing actually works
  verify_billing_works
}
