#!/usr/bin/env ysh
# =============================================================================
# CloudFront Function Deployment
# Deploys the iocaineClassifier.js edge function to CloudFront
# =============================================================================

source-guard aws/deploy-function.ysh || return 0

source $_this_dir/../lib/config.ysh
source $_this_dir/../lib/aws-config.ysh

# -----------------------------------------------------------------------------
# Function Configuration using Native YSH Data Structures
# -----------------------------------------------------------------------------

const FUNCTION_CONFIG = {
  Comment: 'Iocaine edge classifier - routes bots to garbage',
  Runtime: 'cloudfront-js-2.0',
}

proc make_test_event (user_agent, headers_extra) {
  # Build a CloudFront test event as native YSH Dict
  # headers_extra is a Dict of additional headers to include

  var base_headers = {
    'user-agent': {value: user_agent},
    host: {value: 'test.example.com'},
  }

  # Merge extra headers if provided
  if test -n "$headers_extra" {
    # YSH doesn't have dict.update() yet, so we build manually for tests
    pass
  }

  setglobal _TEST_EVENT = {
    version: '1.0',
    context: {
      eventType: 'viewer-request',
    },
    viewer: {
      ip: '1.2.3.4',
    },
    request: {
      method: 'GET',
      uri: '/',
      headers: base_headers,
    },
  }
}

# -----------------------------------------------------------------------------
# Function Deployment
# -----------------------------------------------------------------------------

proc get_function_code_path {
  # Return the path to the iocaineClassifier.js file
  # $_this_dir is the main script's dir (deploy.ysh), so go up one level
  setglobal FUNCTION_CODE_PATH = "$_this_dir/../edge/cloudfront/functions/iocaineClassifier.js"

  if ! test -f "$FUNCTION_CODE_PATH" {
    log "ERROR: Function code not found at $FUNCTION_CODE_PATH"
    exit 1
  }

  log "Function code: $FUNCTION_CODE_PATH"
}

proc get_function_config_json {
  # Write FUNCTION_CONFIG to a temp file and return path
  var tmp = $(mktemp)
  json write (FUNCTION_CONFIG) > $tmp
  setglobal _FUNCTION_CONFIG_JSON = $(cat $tmp)
  rm -f $tmp
}

proc create_function {
  # Create a new CloudFront function
  log_section "Creating CloudFront Function"

  var func_name = AWS_CONFIG.cloudfront.function_name

  get_function_code_path
  get_function_config_json

  log "Creating function: $func_name"

  var result = $(aws cloudfront create-function \
    --name "$func_name" \
    --function-config "$_FUNCTION_CONFIG_JSON" \
    --function-code "fileb://$FUNCTION_CODE_PATH" \
    --output json)

  json read (&result_dict) <<< $result
  var etag = result_dict.ETag

  log "Function created (stage: DEVELOPMENT)"
  log "Publishing to LIVE stage..."

  aws cloudfront publish-function \
    --name "$func_name" \
    --if-match "$etag"

  log "Function published to LIVE stage"

  # Get the ARN for reference
  get_cloudfront_function_arn
  log "Function ARN: $CLOUDFRONT_FUNCTION_ARN"
}

proc update_function {
  # Update existing CloudFront function with new code
  log_section "Updating CloudFront Function"

  var func_name = AWS_CONFIG.cloudfront.function_name

  get_function_code_path
  get_function_config_json

  # Get current ETag
  var current = $(aws cloudfront describe-function \
    --name "$func_name" \
    --output json 2>/dev/null)

  if test -z "$current" {
    log "Function does not exist. Creating new function..."
    create_function
    return
  }

  json read (&current_dict) <<< $current
  var etag = current_dict.ETag

  log "Updating function: $func_name"

  var result = $(aws cloudfront update-function \
    --name "$func_name" \
    --function-config "$_FUNCTION_CONFIG_JSON" \
    --function-code "fileb://$FUNCTION_CODE_PATH" \
    --if-match "$etag" \
    --output json)

  json read (&result_dict) <<< $result
  var new_etag = result_dict.ETag

  log "Function updated (stage: DEVELOPMENT)"
  log "Publishing to LIVE stage..."

  aws cloudfront publish-function \
    --name "$func_name" \
    --if-match "$new_etag"

  log "Function published to LIVE stage"
}

proc deploy_function {
  # Idempotent deploy - creates or updates as needed
  log_section "Deploying CloudFront Function"

  var func_name = AWS_CONFIG.cloudfront.function_name

  # Check if function exists
  var exists = ''
  try {
    setvar exists = $(aws cloudfront describe-function \
      --name "$func_name" \
      --output text 2>/dev/null)
  }

  if test -n "$exists" {
    update_function
  } else {
    create_function
  }
}

proc delete_function {
  # Delete the CloudFront function
  log_section "Deleting CloudFront Function"

  var func_name = AWS_CONFIG.cloudfront.function_name

  # Get current ETag
  var current = $(aws cloudfront describe-function \
    --name "$func_name" \
    --output json 2>/dev/null)

  if test -z "$current" {
    log "Function does not exist"
    return 0
  }

  json read (&current_dict) <<< $current
  var etag = current_dict.ETag

  log "Deleting function: $func_name"

  aws cloudfront delete-function \
    --name "$func_name" \
    --if-match "$etag"

  log "Function deleted"
}

proc test_function {
  # Test the function with sample events using native YSH data
  log_section "Testing CloudFront Function"

  var func_name = AWS_CONFIG.cloudfront.function_name

  # Get current ETag once
  var etag = $(aws cloudfront describe-function --name "$func_name" --query 'ETag' --output text)

  # Test 1: GPTBot (should be 'thief')
  log "Testing with GPTBot user-agent (should be classified as 'thief')..."

  var bot_event = {
    version: '1.0',
    context: {eventType: 'viewer-request'},
    viewer: {ip: '1.2.3.4'},
    request: {
      method: 'GET',
      uri: '/',
      headers: {
        'user-agent': {value: 'Mozilla/5.0 GPTBot/1.0'},
        host: {value: 'test.example.com'},
      },
    },
  }

  var bot_event_json = ''
  json write (bot_event) | read --all (&bot_event_json)
  var bot_b64 = $(echo "$bot_event_json" | base64)

  var result = $(aws cloudfront test-function \
    --name "$func_name" \
    --if-match "$etag" \
    --stage LIVE \
    --event-object "$bot_b64" \
    --output json)

  log "Bot test result:"
  echo "$result" | jq -r '.TestResult.FunctionOutput' | jq .

  # Test 2: Chrome without sec-fetch-mode (should be 'garbage')
  log ""
  log "Testing with Chrome user-agent without sec-fetch-mode (should be 'garbage')..."

  var garbage_event = {
    version: '1.0',
    context: {eventType: 'viewer-request'},
    viewer: {ip: '1.2.3.4'},
    request: {
      method: 'GET',
      uri: '/',
      headers: {
        'user-agent': {value: 'Mozilla/5.0 Chrome/120.0.0.0'},
        host: {value: 'test.example.com'},
      },
    },
  }

  var garbage_event_json = ''
  json write (garbage_event) | read --all (&garbage_event_json)
  var garbage_b64 = $(echo "$garbage_event_json" | base64)

  var result2 = $(aws cloudfront test-function \
    --name "$func_name" \
    --if-match "$etag" \
    --stage LIVE \
    --event-object "$garbage_b64" \
    --output json)

  log "Garbage test result:"
  echo "$result2" | jq -r '.TestResult.FunctionOutput' | jq .

  # Test 3: Legitimate browser (should pass through)
  log ""
  log "Testing with legitimate browser request (should pass through)..."

  var human_event = {
    version: '1.0',
    context: {eventType: 'viewer-request'},
    viewer: {ip: '1.2.3.4'},
    request: {
      method: 'GET',
      uri: '/',
      headers: {
        'user-agent': {value: 'Mozilla/5.0 Chrome/120.0.0.0'},
        host: {value: 'test.example.com'},
        'sec-fetch-mode': {value: 'navigate'},
      },
    },
  }

  var human_event_json = ''
  json write (human_event) | read --all (&human_event_json)
  var human_b64 = $(echo "$human_event_json" | base64)

  var result3 = $(aws cloudfront test-function \
    --name "$func_name" \
    --if-match "$etag" \
    --stage LIVE \
    --event-object "$human_b64" \
    --output json)

  log "Human test result:"
  echo "$result3" | jq -r '.TestResult.FunctionOutput' | jq .
}

proc show_function_info {
  # Display current function status
  log_section "CloudFront Function Info"

  var func_name = AWS_CONFIG.cloudfront.function_name

  var info = $(aws cloudfront describe-function \
    --name "$func_name" \
    --output json 2>/dev/null)

  if test -z "$info" {
    log "Function '$func_name' does not exist"
    return 1
  }

  json read (&info_dict) <<< $info

  var meta = info_dict.FunctionSummary.FunctionMetadata
  var arn = meta.FunctionARN
  var stage = meta.Stage
  var created = meta.CreatedTime
  var updated = meta.LastModifiedTime

  log "Name:    $func_name"
  log "ARN:     $arn"
  log "Stage:   $stage"
  log "Created: $created"
  log "Updated: $updated"
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc function_main {
  require_commands aws jq base64

  set_aws_region
  ensure_aws_auth

  var command = ${1:-deploy}

  case $command in
    deploy)
      deploy_function
      ;;
    create)
      create_function
      ;;
    update)
      update_function
      ;;
    delete)
      delete_function
      ;;
    test)
      test_function
      ;;
    info)
      show_function_info
      ;;
    *)
      echo "Usage: deploy-function.ysh <command>"
      echo ""
      echo "Commands:"
      echo "  deploy   Create or update function (idempotent)"
      echo "  create   Create new function"
      echo "  update   Update existing function"
      echo "  delete   Delete function"
      echo "  test     Test function with sample events"
      echo "  info     Show function status"
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------

if is-main {
  function_main @ARGV
}
