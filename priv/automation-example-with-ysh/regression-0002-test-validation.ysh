#!/usr/bin/env ysh
# =============================================================================
# Regression Test: Test Validation Header Detection
# Issue: k6 test checks for x-cloudfront-iocaine-* headers in RESPONSE, but
#        CloudFront Functions only set these on the REQUEST to origin.
#
# Root cause: The test assumed CloudFront would echo classification headers
#             back to the viewer, but CF Functions are request-modifiers only.
#
# Fix: Detect classification by checking response characteristics:
#      - Bot/garbage traffic → iocaine (Caddy) → text/html, no x-systime-server
#      - Human traffic → systime (Python) → application/json, x-systime-server present
# =============================================================================

source $_this_dir/lib/config.ysh

proc test_classification_detection {
  var cf_url = ${1:-"https://d14tjagvs1cs4y.cloudfront.net"}

  log_section "Regression Test: Classification Detection"
  log "CloudFront URL: $cf_url"
  log ""

  var failed = 0

  # -------------------------------------------------------------------------
  # Test 1: Bot traffic should go to iocaine (Caddy)
  # -------------------------------------------------------------------------
  log "Test 1: Bot traffic (GPTBot) → should route to iocaine"

  var bot_response = $(curl -sI -A "GPTBot/1.0" "$cf_url" 2>/dev/null)
  log "  Response headers (first 5 lines):"
  echo "$bot_response" | head -5 | while read line { log "    $line" }

  # Check for markers
  var bot_result = "unknown"
  case $bot_response in
    (*x-systime-server*)
      setvar bot_result = "systime"
      ;;
    (*text/html*)
      setvar bot_result = "iocaine"
      ;;
  esac

  case $bot_result in
    (systime)
      log "  ❌ FAIL: Bot traffic went to systime (should go to iocaine)"
      setvar failed = failed + 1
      ;;
    (iocaine)
      log "  ✅ PASS: Bot traffic routed to iocaine (HTML response)"
      ;;
    (*)
      log "  ⚠️  WARN: Unexpected response for bot traffic"
      ;;
  esac
  log ""

  # -------------------------------------------------------------------------
  # Test 2: Fake browser traffic should go to iocaine
  # -------------------------------------------------------------------------
  log "Test 2: Fake browser (Chrome UA, no Sec-Fetch) → should route to iocaine"

  var fake_response = $(curl -sI -A "Mozilla/5.0 Chrome/120.0.0.0 Safari/537.36" "$cf_url" 2>/dev/null)
  log "  Response headers (first 5 lines):"
  echo "$fake_response" | head -5 | while read line { log "    $line" }

  var fake_result = "unknown"
  case $fake_response in
    (*x-systime-server*)
      setvar fake_result = "systime"
      ;;
    (*text/html*)
      setvar fake_result = "iocaine"
      ;;
  esac

  case $fake_result in
    (systime)
      log "  ❌ FAIL: Fake browser went to systime (should go to iocaine)"
      setvar failed = failed + 1
      ;;
    (iocaine)
      log "  ✅ PASS: Fake browser routed to iocaine (HTML response)"
      ;;
    (*)
      log "  ⚠️  WARN: Unexpected response for fake browser"
      ;;
  esac
  log ""

  # -------------------------------------------------------------------------
  # Test 3: Human traffic should go to systime
  # -------------------------------------------------------------------------
  log "Test 3: Human traffic (Chrome + Sec-Fetch-Mode) → should route to systime"

  var human_response = $(curl -sI \
    -A "Mozilla/5.0 Chrome/120.0.0.0 Safari/537.36" \
    -H "Sec-Fetch-Mode: navigate" \
    -H "Sec-Fetch-Site: none" \
    -H "Sec-Fetch-Dest: document" \
    "$cf_url" 2>/dev/null)
  log "  Response headers (first 5 lines):"
  echo "$human_response" | head -5 | while read line { log "    $line" }

  var human_result = "unknown"
  case $human_response in
    (*x-systime-server*)
      setvar human_result = "systime"
      ;;
    (*application/json*)
      setvar human_result = "systime"
      ;;
    (*Python*)
      setvar human_result = "systime"
      ;;
    (*text/html*)
      setvar human_result = "iocaine"
      ;;
  esac

  case $human_result in
    (systime)
      log "  ✅ PASS: Human traffic routed to systime"
      ;;
    (iocaine)
      log "  ❌ FAIL: Human traffic went to iocaine (should go to systime)"
      setvar failed = failed + 1
      ;;
    (*)
      log "  ❌ FAIL: Could not determine where human traffic went"
      setvar failed = failed + 1
      ;;
  esac
  log ""

  # -------------------------------------------------------------------------
  # Summary
  # -------------------------------------------------------------------------
  log_section "Results"
  if (failed === 0) {
    log "✅ All tests passed - classification is working correctly"
    log ""
    log "The CloudFront classifier correctly routes:"
    log "  - Bot traffic (GPTBot, etc.) → iocaine"
    log "  - Fake browsers (no Sec-Fetch) → iocaine"
    log "  - Human traffic (with Sec-Fetch) → systime"
    return 0
  } else {
    log "❌ $failed test(s) failed"
    return 1
  }
}

if is-main {
  var url = ${1:-""}
  if test -z "$url" {
    echo "Usage: regression-0002-test-validation.ysh <cloudfront-url>"
    echo ""
    echo "Example:"
    echo "  ./regression-0002-test-validation.ysh https://d14tjagvs1cs4y.cloudfront.net"
    exit 1
  }

  test_classification_detection "$url"
}
