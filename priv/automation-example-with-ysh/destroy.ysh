#!/usr/bin/env ysh
# =============================================================================
# Iocaine Infrastructure Teardown
# Selective cleanup with support for partial deletion
# =============================================================================

source-guard destroy.ysh || return 0

source $_this_dir/lib/config.ysh
source $_this_dir/lib/aws-config.ysh
source $_this_dir/provision-systime.ysh
source $_this_dir/dns.ysh
source $_this_dir/aws/cloudfront.ysh
source $_this_dir/aws/deploy-function.ysh
source $_this_dir/aws/acm.ysh

# -----------------------------------------------------------------------------
# DNS Cleanup
# -----------------------------------------------------------------------------

proc cleanup_dns {
  log "Cleaning up DNS record..."

  try {
    dns_delete
  }

  log "DNS cleanup complete"
}

# -----------------------------------------------------------------------------
# Instance Deletion
# -----------------------------------------------------------------------------

proc delete_iocaine_instance {
  log_section "Deleting Iocaine Instance"

  log "Instance: $[CONFIG.instance_name]"
  log "Project:  $[CONFIG.project]"
  log "Zone:     $[CONFIG.zone]"

  var exists = ''
  try {
    setvar exists = $(gcloud compute instances describe $[CONFIG.instance_name] \
      --project=$[CONFIG.project] \
      --zone=$[CONFIG.zone] \
      --format='value(name)' 2>/dev/null)
  }

  if test -z "$exists" {
    log "Instance does not exist"
    return 0
  }

  gcloud compute instances delete "$[CONFIG.instance_name]" \
    --project="$[CONFIG.project]" \
    --zone="$[CONFIG.zone]" \
    --quiet

  log "Instance deleted"
}

# -----------------------------------------------------------------------------
# Swarm Cleanup
# -----------------------------------------------------------------------------

proc delete_swarm {
  log_section "Deleting Load Test Swarm"

  # Get swarm instances with zones
  var prefix = SWARM_CONFIG.instance_prefix
  var instances = $(gcloud compute instances list \
    --project=$[CONFIG.project] \
    --filter="name~'^$prefix-'" \
    --format='value(name,zone)' 2>/dev/null)

  if test -z "$instances" {
    log "No swarm instances found"
    return 0
  }

  var count = $(echo "$instances" | wc -l | tr -d ' ')
  log "Found $count swarm instance(s) to delete"

  # Delete each instance IN PARALLEL
  var tmp_instances = $(mktemp)
  var pids_file = $(mktemp)
  echo "$instances" > $tmp_instances

  while read line {
    if test -z "$line" {
      continue
    }

    var instance_name = $(echo "$line" | awk '{print $1}')
    var zone = $(echo "$line" | awk '{print $2}')

    if test -n "$instance_name" && test -n "$zone" {
      log "Deleting $instance_name in $zone (background)..."
      (
        gcloud compute instances delete "$instance_name" \
          --project=$[CONFIG.project] \
          --zone="$zone" \
          --quiet 2>/dev/null
        log "  ✓ $instance_name deleted"
      ) &
      echo $! >> $pids_file
    }
  } < $tmp_instances

  # Wait for all background deletions to complete
  log "Waiting for all swarm instances to be deleted..."
  while read pid {
    wait $pid 2>/dev/null || true
  } < $pids_file

  rm -f $tmp_instances $pids_file
  log "All swarm instances deleted"
}

# -----------------------------------------------------------------------------
# Coordinator Cleanup
# -----------------------------------------------------------------------------

proc delete_coordinator {
  log_section "Deleting Coordinator Instance"

  # Check if coordinator exists
  var exists = ''
  try {
    setvar exists = $(gcloud compute instances describe $[COORDINATOR_CONFIG.instance_name] \
      --project=$[CONFIG.project] \
      --zone=$[COORDINATOR_CONFIG.zone] \
      --format='value(name)' 2>/dev/null)
  }

  if test -z "$exists" {
    log "Coordinator instance does not exist"
    return 0
  }

  log "Deleting: $[COORDINATOR_CONFIG.instance_name]"

  gcloud compute instances delete $[COORDINATOR_CONFIG.instance_name] \
    --project=$[CONFIG.project] \
    --zone=$[COORDINATOR_CONFIG.zone] \
    --quiet

  log "Coordinator instance deleted"
}

# -----------------------------------------------------------------------------
# CloudFront Cleanup
# -----------------------------------------------------------------------------

proc delete_cloudfront {
  log_section "Deleting CloudFront Resources"

  set_aws_region

  try {
    ensure_aws_auth
  }

  # Delete CNAME record for CloudFront custom domain first
  var cf_subdomain = AWS_CONFIG.cloudfront.pkb_subdomain
  log "Deleting CloudFront CNAME record..."
  try {
    dns_delete_cname "$cf_subdomain"
  }

  # Delete distribution (must succeed before function can be deleted)
  var dist_deleted = false
  try {
    delete_distribution
    setvar dist_deleted = true
  }

  # Only delete function if distribution was deleted (function is in use otherwise)
  if (dist_deleted) {
    try {
      delete_function
    }

    # Delete ACM certificate after distribution is deleted
    var cf_domain = AWS_CONFIG.cloudfront.domain
    log "Deleting ACM certificate..."
    try {
      delete_acm_certificate "$cf_domain"
    }
  } else {
    log "Skipping function and certificate delete - distribution still exists"
  }

  log "CloudFront resources deleted"
}

# -----------------------------------------------------------------------------
# Selective Destroy Functions
# -----------------------------------------------------------------------------

proc destroy_swarm_only {
  # Delete only swarm VMs - fastest iteration
  log_section "Teardown: Swarm Only"
  log ""
  log "This will delete:"
  log "  - Load test swarm VMs"
  log ""
  log "Keeping:"
  log "  - Iocaine instance"
  log "  - Coordinator (Grafana/InfluxDB)"
  log "  - CloudFront distribution"
  log ""

  confirm_or_abort

  delete_swarm

  log_section "Swarm Cleanup Complete"
  log ""
  log "To re-provision swarm, run: ./deploy.ysh"
}

proc destroy_keep_coordinator {
  # Delete swarm and iocaine, keep coordinator for metrics history
  log_section "Teardown: Keep Coordinator"
  log ""
  log "This will delete:"
  log "  - Load test swarm VMs"
  log "  - Iocaine instance"
  log "  - DNS record"
  log "  - CloudFront distribution"
  log ""
  log "Keeping:"
  log "  - Coordinator (Grafana/InfluxDB)"
  log ""

  confirm_or_abort

  delete_swarm
  delete_cloudfront
  cleanup_dns
  delete_iocaine_instance

  log_section "Cleanup Complete (Coordinator Preserved)"
  log ""
  log "Coordinator still running for metrics history"
  log "To delete coordinator: ./destroy.ysh --coordinator-only"
}

proc destroy_full {
  # Delete everything IN PARALLEL
  log_section "Teardown: Full Cleanup (Parallel)"
  log ""
  log "This will delete ALL resources in parallel:"
  log "  - Load test swarm VMs"
  log "  - Coordinator VM (Grafana/InfluxDB)"
  log "  - Iocaine instance"
  log "  - Systime instance"
  log "  - DNS records"
  log "  - CloudFront distribution"
  log "  - CloudFront function"
  log ""

  confirm_or_abort

  log "Starting parallel deletion..."
  var pids_file = $(mktemp)

  # Delete swarm VMs (background)
  (
    delete_swarm
  ) &
  echo $! >> $pids_file
  log "  → Swarm deletion started (PID: $!)"

  # Delete coordinator VM (background)
  (
    delete_coordinator
  ) &
  echo $! >> $pids_file
  log "  → Coordinator deletion started (PID: $!)"

  # Delete CloudFront resources (background)
  (
    delete_cloudfront
  ) &
  echo $! >> $pids_file
  log "  → CloudFront deletion started (PID: $!)"

  # Delete DNS (background)
  (
    cleanup_dns
  ) &
  echo $! >> $pids_file
  log "  → Iocaine DNS cleanup started (PID: $!)"

  # Delete Iocaine instance (background)
  (
    delete_iocaine_instance
  ) &
  echo $! >> $pids_file
  log "  → Iocaine deletion started (PID: $!)"

  # Delete Systime instance (background)
  (
    delete_systime
  ) &
  echo $! >> $pids_file
  log "  → Systime deletion started (PID: $!)"

  log ""
  log "Waiting for all deletions to complete..."

  # Wait for all background jobs
  var all_ok = true
  while read pid {
    wait $pid 2>/dev/null || setvar all_ok = false
  } < $pids_file

  rm -f $pids_file

  log_section "Full Cleanup Complete"
  log ""
  if (all_ok) {
    log "All resources deleted successfully."
  } else {
    log "Some deletions may have had issues. Check output above."
  }
}

proc destroy_coordinator_only {
  # Delete just the coordinator
  log_section "Teardown: Coordinator Only"
  log ""
  log "This will delete:"
  log "  - Coordinator VM (Grafana/InfluxDB)"
  log ""

  confirm_or_abort

  delete_coordinator

  log_section "Coordinator Cleanup Complete"
}

# -----------------------------------------------------------------------------
# Legacy Default Destroy (just iocaine)
# -----------------------------------------------------------------------------

proc destroy_legacy {
  # Original behavior: just iocaine instance, optional DNS
  var delete_dns = ${DELETE_DNS:-no}

  log_section "Teardown Summary"
  log ""
  log "This will delete:"
  log "  Instance: $[CONFIG.instance_name]"
  log "  Project:  $[CONFIG.project]"
  log "  Zone:     $[CONFIG.zone]"

  if test "$delete_dns" = "yes" {
    log "  DNS:      $[CONFIG.pkb_subdomain].$[CONFIG.pkb_domain] (A record)"
  }

  log ""

  confirm_or_abort

  # Delete DNS if requested
  if test "$delete_dns" = "yes" {
    cleanup_dns
  }

  # Delete instance
  delete_iocaine_instance

  log_section "Teardown Complete"

  if test "$delete_dns" != "yes" {
    log ""
    log "Note: DNS record was NOT deleted."
    log "To delete it manually:"
    log "  ./dns.ysh delete"
  }
}

# -----------------------------------------------------------------------------
# Confirmation Helper
# -----------------------------------------------------------------------------

proc confirm_or_abort {
  # Interactive confirmation unless AUTO_CONFIRM is set
  # Use a subshell to properly check the environment variable
  if /bin/sh -c 'test "$AUTO_CONFIRM" = "yes"' {
    log "AUTO_CONFIRM=yes, proceeding..."
    return
  }

  # Use bash-compatible prompt for interactive use
  /bin/bash -c 'read -p "Are you sure? Type yes to confirm: " confirm && test "$confirm" = "yes"'
  if test $? -ne 0 {
    log "Aborted."
    exit 0
  }
}

# -----------------------------------------------------------------------------
# CLI Interface
# -----------------------------------------------------------------------------

proc destroy_usage {
  echo "Iocaine Infrastructure Teardown"
  echo ""
  echo "Usage: destroy.ysh [option] [--prefix <value>]"
  echo ""
  echo "Options:"
  echo "  --swarm-only         Delete only load test swarm VMs"
  echo "                       Fastest option for iteration"
  echo ""
  echo "  --keep-coordinator   Delete swarm + iocaine + CloudFront"
  echo "                       Keep coordinator for metrics history"
  echo ""
  echo "  --coordinator-only   Delete just the coordinator VM"
  echo ""
  echo "  --full               Delete everything"
  echo "                       Swarm + coordinator + iocaine + CloudFront"
  echo ""
  echo "  --prefix <value>     Target a prefixed deployment (same prefix as deploy.ysh)"
  echo "  --prefix=value       Same as above"
  echo ""
  echo "Legacy (no flags):     Delete just iocaine instance"
  echo "                       Use DELETE_DNS=yes for DNS cleanup"
  echo ""
  echo "Environment:"
  echo "  AUTO_CONFIRM=yes     Skip confirmation prompts"
  echo "  DELETE_DNS=yes       Also delete DNS (legacy mode only)"
  echo ""
  echo "Examples:"
  echo "  ./destroy.ysh --swarm-only                    # Quick cleanup for iteration"
  echo "  ./destroy.ysh --full                          # Full cleanup"
  echo "  ./destroy.ysh --full --prefix 20251127        # Cleanup prefixed deployment"
  echo "  AUTO_CONFIRM=yes ./destroy.ysh --full"
}

proc destroy_main {
  require_commands gcloud

  var command = ''
  var prefix = ''
  var expect_prefix_value = false

  for arg in @ARGV {
    if test "$expect_prefix_value" = true {
      setvar prefix = arg
      setvar expect_prefix_value = false
      continue
    }

    case $arg in
      (--prefix)
        setvar expect_prefix_value = true
        ;;
      (--prefix=*)
        setvar prefix = $(echo "$arg" | cut -d'=' -f2-)
        ;;
      (--swarm-only|--keep-coordinator|--coordinator-only|--full|--help|-h)
        setvar command = arg
        ;;
      (*)
        # Unknown arg, treat as legacy
        ;;
    esac
  }

  # Apply prefix before any operations
  set_deployment_prefix "$prefix"

  if test -n "$DEPLOYMENT_PREFIX" {
    log "Using prefix: $DEPLOYMENT_PREFIX"
    log "Project:      $[CONFIG.project]"
    log ""
  }

  case $command in
    --swarm-only)
      destroy_swarm_only
      ;;
    --keep-coordinator)
      destroy_keep_coordinator
      ;;
    --coordinator-only)
      destroy_coordinator_only
      ;;
    --full)
      destroy_full
      ;;
    --help|-h)
      destroy_usage
      ;;
    *)
      # Legacy behavior
      destroy_legacy
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Entry Point
# -----------------------------------------------------------------------------

if is-main {
  destroy_main @ARGV
}
